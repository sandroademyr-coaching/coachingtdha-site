    card:["Mercado","Misceláneos","Restaurante","Entretenimiento","Hogar","Transporte","Cuidado personal","Ropa","Regalos"],
    budgets:{"Mercado":100,"Misceláneos":100,"Restaurante":275,"Entretenimiento":74,"Hogar":60,"Transporte":60,"Cuidado personal":50,"Ropa":131,"Regalos":150},
    ess:["Mercado","Comida","Transporte","Salud","Cuidado personal","Hogar","Educación","Servicios","Vivienda","Deudas"],
    map:{"Alimentación":"Mercado","Ocio":"Restaurante","Compras":"Misceláneos","Otros":"Cuidado personal"}
  };
  function finRemapTx(withOtros){
    let mt = 0; try{ mt = Number(localStorage.getItem("panel_fin_migt"))||0; }catch(e){}
    const touched = [];
    fin.tx.forEach(t=>{
      if(t.type!=="gasto" || t.space==="hogar") return;
      if(/aporte\s+casa/i.test(t.desc||"")){ t.type = "hogar"; t.cat = "Fondo Hogar"; touched.push(t); return; }
      const to = FIN_V2.map[t.cat]; if(!to) return;
      if(t.cat==="Otros" && !(withOtros && (t.createdAt||0)<=mt)) return;
      t.cat = to; touched.push(t);
    });
    if(touched.length){ touched.forEach(t=>{ if(!cloud.user) t.pending = true; finPushTx(t); }); finSaveLocal(); }
    return touched.length;
  }
  function finApplyCfgV2(){
    const c = fin.cfg, old = Array.isArray(c.cats) ? c.cats : [];
    c.cats = FIN_V2.cats.concat(old.filter(k=>FIN_V2.cats.indexOf(k)<0 && !FIN_V2.map[k]));
    const b = Object.assign({}, c.catBudgets||{}); Object.keys(FIN_V2.map).forEach(k=>{ if(k!=="Otros") delete b[k]; });
    c.catBudgets = Object.assign(b, FIN_V2.budgets);
    c.cardCats = FIN_V2.card.slice(); c.essCats = FIN_V2.ess.slice();
    (c.fixed||[]).forEach(f=>{ if(f.cat && FIN_V2.map[f.cat] && f.cat!=="Otros") f.cat = FIN_V2.map[f.cat]; });
    c.schemaVersion = "finanzas_v2";
    try{ localStorage.setItem("panel_fin_schema","finanzas_v2"); }catch(e){}
  }
  function finMigrateV2(){
    if(!FIN_OWNER_PRESET) return false;
    let done = false; try{ done = localStorage.getItem("panel_fin_schema")==="finanzas_v2"; }catch(e){}
    if(fin.cfg.schemaVersion==="finanzas_v2" && done) return false;
    if(done){ finApplyCfgV2(); finCfgChanged(); return true; }        // otro dispositivo/nube sobrescribió la config
    try{ localStorage.setItem("panel_fin_migt", String(Date.now())); }catch(e){}
    finRemapTx(true); finApplyCfgV2(); finCfgChanged(); return true;
  }
  function finLoad(){
    try{
      const r = JSON.parse(localStorage.getItem(FIN_KEY)||"null");
      if(r){ fin.cfg = Object.assign(fin.cfg, r.cfg||{}); fin.goals = r.goals||[]; fin.invest = r.invest||[]; fin.tx = r.tx||[]; }
    }catch(e){}
    fin.cfg = Object.assign(finCfgDefault(), fin.cfg);
    if(!Array.isArray(fin.cfg.cats) || !fin.cfg.cats.length) fin.cfg.cats = FIN_CATS.slice();
    finMigrateV2();
  }
  function finSaveLocal(){ try{ localStorage.setItem(FIN_KEY, JSON.stringify(fin)); }catch(e){} }
  function finPushCfg(){
    finCfgTimer = null;
    if(!cloud.user || !cloud.db) return;
    cloud.db.doc(`users/${cloud.user.uid}/app/fin_cfg`).set({ json: JSON.stringify({cfg:fin.cfg, goals:fin.goals, invest:fin.invest}), device: cloud.deviceId, updatedAt: Date.now() })
      .catch(e=>console.error(e));
  }
  function finCfgChanged(){
    finSaveLocal();
    if(!cloud.user || !cloud.db) return;
    clearTimeout(finCfgTimer); finCfgTimer = setTimeout(finPushCfg, 1200);
  }
  function finTxClean(t){ const o = Object.assign({}, t); delete o.pending; delete o.id; return o; }
  function finPushTx(t){
    if(!cloud.user || !cloud.db) return;
    cloud.db.doc(`users/${cloud.user.uid}/fin_tx/${t.id}`).set(finTxClean(t)).then(()=>{ t.pending = false; finSaveLocal(); }).catch(e=>console.error(e));
  }
  function finDetach(){ finUnsubs.forEach(f=>{ try{ f(); }catch(e){} }); finUnsubs = []; }
  function finAttach(){
    finDetach();
    if(!cloud.user || !cloud.db) return;
    const u = cloud.user.uid;
    finUnsubs.push(cloud.db.doc(`users/${u}/app/fin_cfg`).onSnapshot(snap=>{
      if(snap.metadata && snap.metadata.hasPendingWrites) return;
      if(!snap.exists){ finPushCfg(); return; }
      const d = snap.data();
      if(d.device === cloud.deviceId && finCfgTimer) return;
      try{
        const j = JSON.parse(d.json);
        fin.cfg = Object.assign(finCfgDefault(), j.cfg||{});
        fin.goals = j.goals||[]; fin.invest = j.invest||[];
        finMigrateV2();
        finSaveLocal(); renderFin();
      }catch(e){ console.error(e); }
    }, err=>console.error(err)));
    let first = true;
    finUnsubs.push(cloud.db.collection(`users/${u}/fin_tx`).onSnapshot(snap=>{
      if(first){
        first = false;
        const m = new Map();
        snap.docs.forEach(dc=>m.set(dc.id, Object.assign({id:dc.id}, dc.data())));
        fin.tx.filter(t=>t.pending && !m.has(t.id)).forEach(t=>{ m.set(t.id, t); finPushTx(t); });
        fin.tx = Array.from(m.values());
        try{ if(localStorage.getItem("panel_fin_schema")==="finanzas_v2") finRemapTx(true); }catch(e){}
      }else{
        const m = new Map(fin.tx.map(t=>[t.id,t]));
        snap.docChanges().forEach(ch=>{
          if(ch.type === "removed") m.delete(ch.doc.id);
          else m.set(ch.doc.id, Object.assign({id:ch.doc.id}, ch.doc.data()));
        });
        fin.tx = Array.from(m.values());
      }
      finSaveLocal(); renderFin();
    }, err=>console.error(err)));
  }

  /* ---- utilidades ---- */
  const finMoney = n => "S/ " + (Number(n)||0).toLocaleString("es-PE",{minimumFractionDigits:2, maximumFractionDigits:2});
  function finColor(pct){ return pct>=100 ? "#ef4444" : pct>=(fin.cfg.alertPct||80) ? "#f59e0b" : "#10b981"; }
  function finMonthLabel(m){ const [y,mo] = m.split("-").map(Number); return new Date(y,mo-1,1).toLocaleDateString("es-PE",{month:"long",year:"numeric"}); }
  function finShift(m, d){ const [y,mo] = m.split("-").map(Number); const x = new Date(y, mo-1+d, 1); return x.getFullYear()+"-"+String(x.getMonth()+1).padStart(2,"0"); }
  function finSum(list, type){ return list.filter(t=>t.type===type).reduce((a,t)=>a+(Number(t.amount)||0),0); }
  function finGuessCat(desc){
    const n = normName(desc);
    if(!n) return "";
    for(const c of Object.keys(FIN_GUESS)){ if(FIN_GUESS[c].some(w=>n.indexOf(w)>=0) && fin.cfg.cats.indexOf(c)>=0) return c; }
    return "";
  }
  function finWeeks(m){
    const [y,mo] = m.split("-").map(Number);
    const N = new Date(y,mo,0).getDate();
    const weeks = []; let cur = null;
    for(let d=1; d<=N; d++){
      const wd = new Date(y,mo-1,d).getDay(); // 0 dom
      if(!cur || wd===1){ cur = {from:d, to:d, days:0}; weeks.push(cur); }
      cur.to = d; cur.days++;
    }
    return {weeks, N};
  }

