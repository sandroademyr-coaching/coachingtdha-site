    const pendFixed = fixedRows.filter(r=>!r.paid).reduce((a,r)=>a+(Number(r.f.amount)||0),0);
    const pendFixedGasto = fixedRows.filter(r=>!r.paid && (r.f.type||"gasto")==="gasto").reduce((a,r)=>a+(Number(r.f.amount)||0),0);
    // KPI 1 · disponible real
