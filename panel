  // 4 · Efecto dominó: cómo rinde un hábito cuando se cumple (o no) otro
  function intelDomino(){
    const drivers = state.habits.some(h=>h.pillar) ? state.habits.filter(h=>h.pillar) : state.habits;
    const days = daysBack(91).slice(1); // sin hoy
    const found = [];
    drivers.forEach(P=>{
      state.habits.forEach(H=>{
        if(H.id===P.id) return;
        let aDone=0,aTot=0,bDone=0,bTot=0;
        days.forEach(d=>{
          const k=todayKey(d);
          if(isOffFor(P,k) || isOffFor(H,k) || d<getHabitStart(P) || d<getHabitStart(H)) return;
          if(P.logs[k]){ aTot++; if(H.logs[k]) aDone++; } else { bTot++; if(H.logs[k]) bDone++; }
        });
        if(aTot<8 || bTot<8) return;
        const ra = Math.round(aDone/aTot*100), rb = Math.round(bDone/bTot*100);
        found.push({P,H,ra,rb,diff:ra-rb});
      });
    });
    const top = found.filter(x=>x.diff>=15).sort((a,b)=>b.diff-a.diff);
    const used = new Set(); const picked = [];
    top.forEach(x=>{ const key=x.P.id+"|"+x.H.id; if(picked.length<3 && !used.has(x.H.id)){ used.add(x.H.id); picked.push(x); } });
