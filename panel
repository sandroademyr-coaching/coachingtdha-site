  function renderHeatmap(){
    const grid = document.getElementById("heatmapGrid");
    grid.innerHTML = "";
    const totalDays = 14*7;
    const start = dateFromOffset(-(totalDays-1));
    for(let i=0;i<totalDays;i++){
      const d = new Date(start); d.setDate(d.getDate()+i);
      const key = todayKey(d);
      const off = isDayDisabled(key);
      let done=0;
      const hmAct = state.habits.filter(h=>!isRest(h,key));
      hmAct.forEach(h=>{ if(h.logs[key]) done++; });
      const ratio = hmAct.length ? done/hmAct.length : 0;
      const cell = document.createElement("div");
      cell.className = "hm-cell" + (off ? " off" : "");
      cell.title = off
        ? `${d.toLocaleDateString('es-PE',{day:'numeric',month:'short'})} · día libre (${state.disabledDays[key]})`
        : `${d.toLocaleDateString('es-PE',{day:'numeric',month:'short'})} · ${done}/${state.habits.length}`;
      if(!off){
        if(ratio===0) cell.style.background = "var(--surface-2)";
        else if(ratio<=0.34) cell.style.background = "var(--accent-soft)";
        else if(ratio<=0.67) cell.style.background = "var(--accent-soft-2)";
        else cell.style.background = "var(--accent)";
      }
      cell.style.cursor = "pointer";
      cell.addEventListener("click", ()=> openBackfillModal(key, "day"));
      grid.appendChild(cell);
    }
  }

