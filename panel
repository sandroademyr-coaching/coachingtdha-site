<script>
(function(){
  "use strict";

  /* ---------------- Persistencia ---------------- */
  const STORAGE_KEY = "panel_sandro_v1";

  /* ====== NUBE: pega aquí la configuración de tu proyecto Firebase (ver guía) ====== */
  const FIREBASE_CONFIG = { apiKey:"AIzaSyAaI1vesv96XnO9qNhuf-wrgGi3dToqlLo", authDomain:"panel-tdha.firebaseapp.com", projectId:"panel-tdha", appId:"1:1084459906856:web:a84183e1507cf750a0821d" };
  const cloud = { on:false, user:null, auth:null, db:null, ref:null, unsub:null, baseRev:0, dirty:false, seq:0, timer:null,
                  pushing:false, applying:false, pendingRemote:null, retry:null, status:"local",
                  deviceId: (function(){ try{ let d=localStorage.getItem("panel_device_id"); if(!d){ d=Math.random().toString(36).slice(2,12); localStorage.setItem("panel_device_id",d);} return d; }catch(e){ return "dev"; } })() };
  const ACCENTS = ["#c9a227","#e3c15a","#4d9de0","#3ddc84","#b06fe0","#cc1111"];
  const EMOJIS = ["🎯","📚","💧","🏃","🧘","💪","🛌","🥗","✍️","🎧","🧠","☀️","💼","🎨","🚭","💰"];

  function todayKey(d){
    d = d || new Date();
    const y=d.getFullYear(), m=String(d.getMonth()+1).padStart(2,"0"), day=String(d.getDate()).padStart(2,"0");
    return `${y}-${m}-${day}`;
  }
  function uid(){ return Math.random().toString(36).slice(2,10); }

  function normName(n){ return String(n||"").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,""); }
  function guessTier(name){
    const n = normName(name);
    if(/estudi|ejercic|lectur|entren|gym|trabaj|program/.test(n)) return "core";
    if(/descans|dormir|sueno|meditac|respir|yoga|siesta/.test(n)) return "recarga";
    return "base";
  }
  function guessTimeframe(name){
    const n = normName(name);
    if(/cierre|orden|limpiez/.test(n)) return "pm";
    if(/hidrat|agua|movil|celular|pantalla|abstin|descans|dormir|sueno|redes/.test(n)) return "24h";
    return "am";
  }
  function guessPhase(name){
    const n = normName(name);
    if(/ejercic|gym|cardio|lectur/.test(n)) return "1";
    if(/estudi|paseo|luna|meditac/.test(n)) return "2";
    return "";
  }
  function isAbstinence(h){
    return /abstin|movil|celular|pantalla|redes|uso reducido/.test(normName(h.name));
  }
  function guessPillar(name){
    return /estudi|ejercic|descans/.test(normName(name));
  }

  function defaultState(){
    return {
      settings: { accent: "#c9a227", bgColor: "#0a0a0a", dayStart: 17, dayEnd: 23, lastBackup: "" },
      habits: [],
      agenda: {},
      eisenhower: {},
      journal: {},
      objectives: { week:{}, month:{}, quarter:{}, year:{} },
      periodEisenhower: { week:{}, month:{}, quarter:{}, year:{} },
      reminders: [],
      disabledDays: {},
      diagnostics: {},
      bigRocks: {},
      blockLog: {},
      routineBlocks: [
        {id:"b1", start:"05:30", end:"08:00", icon:"🟢", title:"Rutina AM & Gimnasio"},
        {id:"b2", start:"08:15", end:"08:45", icon:"📘", title:"Desayuno + Estudio PNL/Ventas"},
        {id:"b3", start:"09:00", end:"10:20", icon:"🐕", title:"Parque con Luna & Meditación Cuadrada"},
        {id:"b4", start:"10:30", end:"19:00", icon:"💼", title:"Turno Operativo & Prospección", op:true},
        {id:"b5", start:"19:00", end:"19:15", icon:"🧹", title:"Cierre de Estación + Respiración 4-7-8"}
      ]
    };
  }

  let state = load();
  function load(){
    try{
      const raw = localStorage.getItem(STORAGE_KEY);
      if(!raw) return defaultState();
      const parsed = JSON.parse(raw);
      const merged = Object.assign(defaultState(), parsed);
      merged.settings = Object.assign({}, defaultState().settings, parsed.settings||{});
      // migración: nivel de pipeline y hábito pilar (valores sugeridos por nombre, editables en el hábito)
      (merged.habits||[]).forEach(h=>{
        if(!h.tier) h.tier = guessTier(h.name);
        if(h.pillar===undefined) h.pillar = guessPillar(h.name);
        if(!h.timeframe) h.timeframe = guessTimeframe(h.name);
        if(h.phase===undefined) h.phase = h.timeframe==="am" ? guessPhase(h.name) : "";
        if(h.causes){
          const map = {fatiga:"energia", interrupcion:"tiempo", desorganizacion:"tiempo"};
          Object.keys(h.causes).forEach(k=>{ if(map[h.causes[k]]) h.causes[k] = map[h.causes[k]]; });
        }
      });
      const pillarsNow = (merged.habits||[]).filter(h=>h.pillar);
      if(pillarsNow.length>3) pillarsNow.slice(3).forEach(h=>{ h.pillar = false; });
      // migración: recordatorios antiguos guardaban "datetime" en vez de "eventDatetime"+"offsetMinutes"
      merged.reminders = (merged.reminders||[]).map(r=>{
        if(r.eventDatetime) return r;
        return { ...r, eventDatetime: r.datetime, offsetMinutes: 0 };
      });
      // migración: actividades de agenda antiguas usaban "done" (booleano) y el tipo "pendiente"
      Object.keys(merged.agenda||{}).forEach(dateKey=>{
        merged.agenda[dateKey] = merged.agenda[dateKey].map(item=>{
          const fixed = { ...item };
          if(!fixed.status) fixed.status = fixed.done ? "completo" : "pendiente";
          if(fixed.type==="pendiente") fixed.type = "otro";
          if(fixed.type==="mascota" || fixed.type==="salud") fixed.type = "personal";
          if(fixed.type==="cita") fixed.type = "reunion";
          delete fixed.done;
          return fixed;
        });
      });
      return merged;
    }catch(e){ return defaultState(); }
  }
  function save(){
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    cloudTouch();
  }

  function toast(msg){
    const t = document.getElementById("toast");
    t.textContent = msg;
    t.classList.add("show");
    clearTimeout(toast._h);
    toast._h = setTimeout(()=>t.classList.remove("show"), 1800);
  }

  /* ---------------- Reloj / fecha ---------------- */
  function updateClock(){
    const now = new Date();
    const opts = {weekday:"long", day:"numeric", month:"long"};
    document.getElementById("clockPill").textContent =
      now.toLocaleDateString("es-PE", opts) + " · " + now.toLocaleTimeString("es-PE",{hour:"2-digit",minute:"2-digit"});
  }
  updateClock();
  setInterval(updateClock, 30000);

  /* ---------------- Tabs ---------------- */
  document.querySelectorAll("#mainTabs .tab-btn").forEach(btn=>{
    btn.addEventListener("click", ()=>{
      document.querySelectorAll("#mainTabs .tab-btn").forEach(b=>b.classList.remove("active"));
      document.querySelectorAll(".view").forEach(v=>v.classList.remove("active"));
      btn.classList.add("active");
      document.getElementById("view-"+btn.dataset.view).classList.add("active");
      if(btn.dataset.view==="journal") journalOnShow();
    });
  });

  /* ---------------- Ajustes ---------------- */
  const settingsBtn = document.getElementById("settingsBtn");
  const settingsPop = document.getElementById("settingsPop");
  settingsBtn.addEventListener("click", (e)=>{ e.stopPropagation(); settingsPop.classList.toggle("open"); });
  document.addEventListener("click", (e)=>{
    if(!settingsPop.contains(e.target) && e.target!==settingsBtn) settingsPop.classList.remove("open");
  });

  function applyAccent(){
    // migración de paleta: el rojo/negro anterior pasa al dorado de la web
    if(["#cc1111","#ef4444"].indexOf((state.settings.accent||"").toLowerCase())>=0) state.settings.accent = "#c9a227";
    document.documentElement.style.setProperty("--accent", state.settings.accent);
    // derive soft variants
    const hex = state.settings.accent.replace("#","");
    const r=parseInt(hex.substr(0,2),16), g=parseInt(hex.substr(2,2),16), b=parseInt(hex.substr(4,2),16);
    document.documentElement.style.setProperty("--accent-soft", `rgba(${r},${g},${b},.14)`);
    document.documentElement.style.setProperty("--accent-soft-2", `rgba(${r},${g},${b},.28)`);
    const lum = (0.299*r + 0.587*g + 0.114*b)/255;
    document.documentElement.style.setProperty("--on-accent", lum > 0.52 ? "#0a0a0a" : "#fff");
  }

  function shadeColor(hex, percent){
    hex = hex.replace("#","");
    let r = parseInt(hex.substr(0,2),16), g = parseInt(hex.substr(2,2),16), b = parseInt(hex.substr(4,2),16);
    r = Math.min(255, Math.max(0, Math.round(r + (255-r)*(percent/100))));
    g = Math.min(255, Math.max(0, Math.round(g + (255-g)*(percent/100))));
    b = Math.min(255, Math.max(0, Math.round(b + (255-b)*(percent/100))));
    return "#" + [r,g,b].map(v=>v.toString(16).padStart(2,"0")).join("");
  }

  function applyBackground(){
    if((state.settings.bgColor||"").toLowerCase()==="#0d0d0d") state.settings.bgColor = "#0a0a0a";
    const bg = state.settings.bgColor || "#0a0a0a";
    if(bg.toLowerCase()==="#0a0a0a"){
      const R = document.documentElement.style;
      R.setProperty("--bg","#0a0a0a"); R.setProperty("--surface","#131313"); R.setProperty("--surface-2","#1a1a17");
      R.setProperty("--surface-3","#222220"); R.setProperty("--border","#262620");
      return;
    }
    document.documentElement.style.setProperty("--bg", bg);
    document.documentElement.style.setProperty("--surface", shadeColor(bg, 6));
    document.documentElement.style.setProperty("--surface-2", shadeColor(bg, 12));
    document.documentElement.style.setProperty("--surface-3", shadeColor(bg, 18));
    document.documentElement.style.setProperty("--border", shadeColor(bg, 24));
  }

  function buildSettingsUI(){
    const sw = document.getElementById("accentSwatches");
    sw.innerHTML = "";
    ACCENTS.forEach(c=>{
      const el = document.createElement("div");
      el.className = "swatch" + (state.settings.accent===c ? " sel":"");
      el.style.background = c;
      el.addEventListener("click", ()=>{
        state.settings.accent = c; save(); applyAccent(); buildSettingsUI(); renderAll();
      });
      sw.appendChild(el);
    });
    const ds = document.getElementById("dayStartSel"), de = document.getElementById("dayEndSel");
    const customInput = document.getElementById("customAccentInput");
    customInput.value = state.settings.accent;
    customInput.oninput = ()=>{
      state.settings.accent = customInput.value; save(); applyAccent(); buildSettingsUI(); renderAll();
    };
    const bgInput = document.getElementById("customBgInput");
    bgInput.value = state.settings.bgColor || "#0a0a0a";
    bgInput.oninput = ()=>{
      state.settings.bgColor = bgInput.value; save(); applyBackground();
    };
    ds.innerHTML = ""; de.innerHTML = "";
    for(let h=0; h<24; h++){
      const label = (h%12===0?12:h%12) + (h<12?" a.m.":" p.m.");
      const o1=document.createElement("option"); o1.value=h; o1.textContent=label;
      const o2=document.createElement("option"); o2.value=h; o2.textContent=label;
      if(h===state.settings.dayStart) o1.selected=true;
      if(h===state.settings.dayEnd) o2.selected=true;
      ds.appendChild(o1); de.appendChild(o2);
    }
    ds.onchange = ()=>{ state.settings.dayStart = parseInt(ds.value); save(); renderAgenda(); };
    de.onchange = ()=>{ state.settings.dayEnd = parseInt(de.value); save(); renderAgenda(); };
  }

  document.getElementById("exportBtn").addEventListener("click", ()=>doExport());
  document.getElementById("importInput").addEventListener("change", (e)=>{
    const file = e.target.files[0];
    if(file) importJsonFile(file);
    e.target.value = "";
  });

  /* ================= HÁBITOS ================= */
  const habitModal = document.getElementById("habitModal");
  let editingHabitId = null;
  let selectedEmoji = EMOJIS[0];
  let selectedColor = ACCENTS[0];

  function togglePhaseField(){
    const am = document.getElementById("habitTimeframeInput").value==="am";
    document.getElementById("habitPhaseField").style.display = am ? "" : "none";
  }
  document.getElementById("habitTimeframeInput").addEventListener("change", togglePhaseField);
  let restSel = [];
  function buildRestChips(){
    const g=document.getElementById("habitRestInput"); g.innerHTML="";
    [["L",1],["M",2],["X",3],["J",4],["V",5],["S",6],["D",0]].forEach(([n,i])=>{
      const b=document.createElement("button"); b.type="button";
      b.className="jtag"+(restSel.indexOf(i)>=0?" sel":""); b.textContent=n;
      b.addEventListener("click",()=>{ const p=restSel.indexOf(i); if(p>=0) restSel.splice(p,1); else restSel.push(i); buildRestChips(); });
      g.appendChild(b);
    });
  }
  function openHabitModal(habit){
    editingHabitId = habit ? habit.id : null;
    document.getElementById("habitModalTitle").textContent = habit ? "Editar hábito" : "Nuevo hábito";
    document.getElementById("habitNameInput").value = habit ? habit.name : "";
    document.getElementById("habitTargetInput").value = habit ? habit.target : 7;
    document.getElementById("habitTierInput").value = habit ? (habit.tier || guessTier(habit.name)) : "base";
    document.getElementById("habitPillarInput").value = habit && habit.pillar ? "1" : "0";
    document.getElementById("habitTimeframeInput").value = habit ? (habit.timeframe || guessTimeframe(habit.name)) : "am";
    document.getElementById("habitPhaseInput").value = habit ? (habit.phase || "") : "";
    togglePhaseField();
    restSel = habit ? restDaysOf(habit).slice() : []; buildRestChips();
    selectedEmoji = habit ? habit.icon : EMOJIS[0];
    selectedColor = habit ? habit.color : ACCENTS[0];
    document.getElementById("deleteHabitBtn").style.display = habit ? "inline-flex" : "none";
    buildEmojiGrid(); buildHabitSwatches();
    habitModal.classList.add("open");
  }
  function closeHabitModal(){ habitModal.classList.remove("open"); }

  function buildEmojiGrid(){
    const g = document.getElementById("emojiGrid"); g.innerHTML = "";
    EMOJIS.forEach(em=>{
      const el = document.createElement("div");
      el.className = "emoji-opt" + (em===selectedEmoji ? " sel":"");
      el.textContent = em;
      el.addEventListener("click", ()=>{ selectedEmoji = em; buildEmojiGrid(); });
      g.appendChild(el);
    });
  }
  function buildHabitSwatches(){
    const g = document.getElementById("habitSwatches"); g.innerHTML = "";
    ACCENTS.forEach(c=>{
      const el = document.createElement("div");
      el.className = "swatch" + (c===selectedColor ? " sel":"");
      el.style.background = c;
      el.addEventListener("click", ()=>{ selectedColor = c; buildHabitSwatches(); });
      g.appendChild(el);
    });
  }

  document.getElementById("addHabitBtn").addEventListener("click", ()=>openHabitModal(null));
  document.getElementById("cancelHabitBtn").addEventListener("click", closeHabitModal);
  habitModal.addEventListener("click", (e)=>{ if(e.target===habitModal) closeHabitModal(); });

  document.getElementById("saveHabitBtn").addEventListener("click", ()=>{
    const name = document.getElementById("habitNameInput").value.trim();
    if(!name){ toast("Ponle un nombre al hábito"); return; }
    const target = parseInt(document.getElementById("habitTargetInput").value);
    const tier = document.getElementById("habitTierInput").value;
    const pillar = document.getElementById("habitPillarInput").value==="1";
    const timeframe = document.getElementById("habitTimeframeInput").value;
    const phase = timeframe==="am" ? document.getElementById("habitPhaseInput").value : "";
    const otherPillars = state.habits.filter(x=>x.pillar && x.id!==editingHabitId).length;
    if(pillar && otherPillars>=3){ toast("Ya tienes 3 hábitos pilar. Quita uno para marcar este."); return; }
    if(editingHabitId){
      const h = state.habits.find(x=>x.id===editingHabitId);
      h.name=name; h.icon=selectedEmoji; h.color=selectedColor; h.target=target; h.tier=tier; h.pillar=pillar; h.timeframe=timeframe; h.phase=phase; h.restDays=restSel.slice();
    } else {
      state.habits.push({ id:uid(), name, icon:selectedEmoji, color:selectedColor, target, tier, pillar, timeframe, phase, restDays:restSel.slice(), createdAt:todayKey(), logs:{} });
    }
    save(); closeHabitModal(); renderHabits();
  });
  document.getElementById("deleteHabitBtn").addEventListener("click", ()=>{
    if(!editingHabitId) return;
    state.habits = state.habits.filter(h=>h.id!==editingHabitId);
    save(); closeHabitModal(); renderHabits();
  });

  function dateFromOffset(offset){
    const d = new Date(); d.setDate(d.getDate()+offset); return d;
  }
  function last7Dates(){
    const arr = [];
    for(let i=6;i>=0;i--) arr.push(dateFromOffset(-i));
    return arr;
  }
  function isDayDisabled(key){ return !!state.disabledDays[key]; }
  // Días de descanso por hábito (0=domingo…6=sábado). Ejercicios: domingo por defecto.
  function restDaysOf(h){ return Array.isArray(h.restDays) ? h.restDays : (/ejercic/i.test(h.name||"") ? [0] : []); }
  function isRest(h,key){ const rd=restDaysOf(h); return rd.length>0 && !h.logs[key] && rd.indexOf(new Date(key+"T00:00:00").getDay())>=0; }
  function isOffFor(h,key){ return isDayDisabled(key) || isRest(h,key); }
  function countRestInRange(h,start,end){ let c=0; for(let d=new Date(start); d<=end; d.setDate(d.getDate()+1)){ const k=todayKey(d); if(!isDayDisabled(k) && isRest(h,k)) c++; } return c; }
  function countDisabledInRange(start, end){
    let count=0;
    for(let d=new Date(start); d<=end; d.setDate(d.getDate()+1)){
      if(isDayDisabled(todayKey(d))) count++;
    }
    return count;
  }

  function getHabitStart(habit){
    // punto de partida real del seguimiento: la fecha de creación, o la marca más antigua
    // si el usuario cargó historial de meses anteriores a la creación del hábito
    const created = new Date(habit.createdAt+"T00:00:00");
    const loggedTrue = Object.keys(habit.logs).filter(k=>habit.logs[k]).sort();
    if(loggedTrue.length){
      const earliest = new Date(loggedTrue[0]+"T00:00:00");
      if(earliest < created) return earliest;
    }
    return created;
  }

  function computeStreak(habit){
    let streak = 0;
    let d = new Date();
    const start = getHabitStart(habit);
    const tKey = todayKey(d);
    // si hoy no está registrado y no es día libre, empezamos a contar desde ayer (todavía tiene tiempo hoy)
    if(!habit.logs[tKey] && !isOffFor(habit,tKey)){ d.setDate(d.getDate()-1); }
    let guard = 0;
    while(d>=start && guard<3660){
      const key = todayKey(d);
      if(habit.logs[key]){ streak++; d.setDate(d.getDate()-1); guard++; continue; }
      if(isOffFor(habit,key)){ d.setDate(d.getDate()-1); guard++; continue; } // día libre: no rompe la racha
      break;
    }
    return streak;
  }
  function computeBestStreak(habit){
    const start = getHabitStart(habit);
    const now = new Date();
    let cur=0, best=0;
    for(let d=new Date(start); d<=now; d.setDate(d.getDate()+1)){
      const key = todayKey(d);
      if(habit.logs[key]){ cur++; best=Math.max(best,cur); }
      else if(!isOffFor(habit,key)){ cur=0; }
      // si es día libre, la racha se mantiene (no suma ni se rompe)
    }
    return best;
  }
  function weeklyRate(habit){
    const days = last7Dates().filter(d=>!isOffFor(habit,todayKey(d)));
    const done = days.filter(d=>habit.logs[todayKey(d)]).length;
    const denom = Math.max(1, Math.min(habit.target, days.length || habit.target));
    return Math.min(100, Math.round((done / denom) * 100));
  }

  const COL = {ok:"#10b981", warn:"#f59e0b", bad:"#ef4444", neutral:"#2a2e3b"};
  function progressColor(pct){
    if(pct>=80) return COL.ok;
    if(pct>=50) return COL.warn;
    return COL.bad;
  }

  function ringSVG(pct, color){
    const r=16, c=2*Math.PI*r, off = c - (Math.min(pct,100)/100)*c;
    return `<svg width="38" height="38" viewBox="0 0 38 38">
      <circle cx="19" cy="19" r="${r}" fill="none" stroke="var(--surface-3)" stroke-width="4"/>
      <circle cx="19" cy="19" r="${r}" fill="none" stroke="${color}" stroke-width="4"
        stroke-linecap="round" stroke-dasharray="${c}" stroke-dashoffset="${off}"/>
    </svg>`;
  }

  function donutSVG(pct, color, opts){
    opts = opts || {};
    const size = opts.size || 64;
    const sw = opts.strokeWidth || 6;
    const cls = opts.wrapClass || "kpi-donut";
    const valClass = opts.valueClass || "kpi-donut-value";
    const cx = size/2, r = size/2 - sw, c = 2*Math.PI*r, off = c - (Math.min(pct,100)/100)*c;
    return `<div class="${cls}" style="width:${size}px;height:${size}px;">
      <svg width="${size}" height="${size}" viewBox="0 0 ${size} ${size}">
        <circle cx="${cx}" cy="${cx}" r="${r}" fill="none" stroke="var(--surface-3)" stroke-width="${sw}"/>
        <circle class="trend-dot" cx="${cx}" cy="${cx}" r="${r}" fill="none" stroke="${color}" stroke-width="${sw}"
          stroke-linecap="round" stroke-dasharray="${c}" stroke-dashoffset="${off}" transform="rotate(-90 ${cx} ${cx})"/>
      </svg>
      <div class="${valClass}">${pct}%</div>
    </div>`;
  }

  function computeHabitStats(h){
    const start = getHabitStart(h);
    const now = new Date();
    const rawDays = Math.max(1, Math.round((now-start)/86400000)+1);
    const daysSinceCreation = Math.max(1, rawDays - countDisabledInRange(start, now));
    const totalDone = Object.values(h.logs).filter(Boolean).length;
    const allTimeRate = Math.min(100, Math.round((totalDone/daysSinceCreation)*100));

    const y=now.getFullYear(), m=now.getMonth();
    const monthStart = new Date(y,m,1);
    const rawDaysInMonth = now.getDate();
    const daysInMonthSoFar = Math.max(1, rawDaysInMonth - countDisabledInRange(monthStart, now) - countRestInRange(h, monthStart, now));
    let monthDone=0;
    Object.keys(h.logs).forEach(k=>{
      if(h.logs[k]){
        const d=new Date(k+"T00:00:00");
        if(d>=monthStart && d<=now) monthDone++;
      }
    });
    const monthRate = Math.min(100, Math.round((monthDone/daysInMonthSoFar)*100));
    return { totalDone, allTimeRate, monthDone, monthRate, best: computeBestStreak(h) };
  }

  /* ---------------- Métricas de alto rendimiento ---------------- */
  const TIER_META = {
    core:{label:"Hábitos Core / Motor", sub:"Alto impacto cognitivo", color:"#8f8f8f"},
    recarga:{label:"Recarga y biología", sub:"Sostén", color:"#8f8f8f"},
    base:{label:"Disciplina base", sub:"Baja fricción", color:"#8f8f8f"}
  };
  const TIER_ORDER = ["core","recarga","base"];
  const DAY_NAMES = ["domingo","lunes","martes","miércoles","jueves","viernes","sábado"];
  function tierOf(h){ return TIER_META[h.tier] ? h.tier : guessTier(h.name); }
  function startOfToday(){ const d = new Date(); d.setHours(0,0,0,0); return d; }
  function shortMonth(d){ return d.toLocaleDateString("es-PE",{month:"short"}).replace(".",""); }
  function avg(arr){ return arr.length ? arr.reduce((a,b)=>a+b,0)/arr.length : null; }

  function statusFor(pct){
    if(pct===null) return {label:"sin datos", color:"#5c5c5c"};
    if(pct>=80) return {label:"estable", color:COL.ok};
    if(pct>=65) return {label:"en riesgo", color:COL.warn};
    if(pct>=50) return {label:"desviación", color:COL.warn};
    if(pct>=20) return {label:"baja ejecución", color:COL.bad};
    if(pct===0) return {label:"fuga total", color:COL.bad};
    return {label:"alerta roja", color:COL.bad};
  }

  // % de cumplimiento de un hábito en un rango de días (excluye días libres y días previos al inicio del hábito)
  function rangeRate(habit, start, end){
    const hs = getHabitStart(habit);
    const from = start > hs ? start : hs;
    let total=0, done=0;
    for(let d=new Date(from); d<=end; d.setDate(d.getDate()+1)){
      const key = todayKey(d);
      if(isOffFor(habit,key)) continue;
      total++;
      if(habit.logs[key]) done++;
    }
    return total ? Math.round(done/total*100) : null;
  }
  // ventana de los últimos N días completos (termina ayer)
  function rateLastDays(habit, n){
    const end = startOfToday(); end.setDate(end.getDate()-1);
    const start = new Date(end); start.setDate(start.getDate()-(n-1));
    return rangeRate(habit, start, end);
  }
  function overallLastDays(n){
    const rates = state.habits.map(h=>rateLastDays(h,n)).filter(r=>r!==null);
    const a = avg(rates);
    return a===null ? null : Math.round(a);
  }

  function computeMoM(){
    const now = new Date();
    const cur = new Date(now.getFullYear(), now.getMonth(), 1);
    const prev = new Date(now.getFullYear(), now.getMonth()-1, 1);
    const prev2 = new Date(now.getFullYear(), now.getMonth()-2, 1);
    const rc = computeMonthlyRate(null, cur), rp = computeMonthlyRate(null, prev), rp2 = computeMonthlyRate(null, prev2);
    const rel = (a,b)=> (a===null||b===null||b===0) ? null : ((a-b)/b)*100;
    return { cur, prev, prev2, rc, rp, rp2, relCur: rel(rc,rp), relPrev: rel(rp,rp2), daysSample: now.getDate() };
  }

  function computeChurn(){
    const today = startOfToday();
    const winStart = new Date(today); winStart.setDate(winStart.getDate()-30);
    const scanStart = new Date(today); scanStart.setDate(scanStart.getDate()-150);
    const perWeekday = [0,0,0,0,0,0,0];
    const events = [];
    state.habits.forEach(h=>{
      const hs = getHabitStart(h);
      const from = hs > scanStart ? hs : scanStart;
      let run = 0;
      for(let d=new Date(from); d<today; d.setDate(d.getDate()+1)){
        const key = todayKey(d);
        if(isOffFor(h,key)) continue;
        if(h.logs[key]){ run++; continue; }
        if(run>=3 && d>=winStart){ events.push({habit:h, len:run, date:new Date(d)}); perWeekday[d.getDay()]++; }
        run = 0;
      }
    });
    let top = -1;
    perWeekday.forEach((c,i)=>{ if(c>0 && (top===-1 || c>perWeekday[top])) top = i; });
    return { count: events.length, lostDays: events.reduce((a,e)=>a+e.len,0), perWeekday, topDay: top, events };
  }

  // Resiliencia: de los días en que fallaste, % en que recuperaste el hábito al día siguiente (últimos 90 días)
  function computeResilience(){
    const today = startOfToday();
    let misses=0, bounces=0;
    state.habits.forEach(h=>{
      const hs = getHabitStart(h);
      for(let i=2;i<=90;i++){
        const d = new Date(today); d.setDate(d.getDate()-i);
        if(d<hs) break;
        const k = todayKey(d);
        if(isOffFor(h,k) || h.logs[k]) continue;
        const n = new Date(d); n.setDate(n.getDate()+1);
        let nk = todayKey(n), guard=0;
        while(isOffFor(h,nk) && guard<4){ n.setDate(n.getDate()+1); nk=todayKey(n); guard++; }
        misses++; if(h.logs[nk]) bounces++;
      }
    });
    return misses ? {rate:Math.round(bounces/misses*100), misses, bounces} : null;
  }
  // Días maestros: días del mes en que TODOS los hábitos pilar se cumplieron
  function computeMasterDays(){
    const pillars = state.habits.filter(h=>h.pillar);
    if(!pillars.length) return null;
    const today = startOfToday();
    let count=0, elapsed=0;
    for(let d=new Date(today.getFullYear(), today.getMonth(), 1); d<=today; d.setDate(d.getDate()+1)){
      const k = todayKey(d);
      if(isDayDisabled(k)) continue;
      const isToday = k===todayKey(today);
      const all = pillars.every(h=>h.logs[k] || isRest(h,k));
      if(all) count++;
      if(!isToday || all) elapsed++;
    }
    return {count, elapsed};
  }

  function renderKPIs(){
    const habits = state.habits;
    const grid = document.getElementById("kpiGrid");
    if(habits.length===0){ grid.innerHTML = ""; return; }

    const g30 = overallLastDays(30) || 0;
    const globalCard = `
      <div class="kpi-card kpi-donut-card" data-tip="Cumplimiento global\\nPromedio de todos tus hábitos, últimos 30 días">
        <div class="label">Cumplimiento global 30d</div>
        ${donutSVG(g30, progressColor(g30))}
      </div>`;

    const pillars = habits.filter(h=>h.pillar).slice(0,3);
    let pillarCard;
    if(pillars.length===0){
      pillarCard = `<div class="kpi-card"><div class="label">Índice hábitos pilar</div><div class="value">—</div><div class="kpi-note">Marca hasta 3 pilares (✎ en el hábito)</div></div>`;
    } else {
      const rows = pillars.map(h=>({h, r:rateLastDays(h,30)})).filter(x=>x.r!==null);
      const idx = rows.length ? Math.round(avg(rows.map(x=>x.r))) : 0;
      const weak = rows.slice().sort((a,b)=>a.r-b.r)[0];
      const wst = weak ? statusFor(weak.r) : null;
      const tip = rows.map(x=>`${x.h.name.split("(")[0].trim()}: ${x.r}%`).join("\\n");
      pillarCard = `
      <div class="kpi-card kpi-donut-card" data-tip="Índice pilar\\n${tip.replace(/"/g,"&quot;")}">
        <div class="label">Índice hábitos pilar</div>
        ${donutSVG(idx, progressColor(idx))}
        ${weak && weak.r<80 ? `<div class="kpi-note"><i class="dot ${weak.r<20?"pulse":""}" style="--c:${wst.color};"></i>${weak.h.name.split("(")[0].trim()} ${wst.label}</div>` : `<div class="kpi-note">Pilares estables</div>`}
      </div>`;
    }

    const rs = computeResilience();
    const resCard = `
      <div class="kpi-card" data-tip="Tasa de resiliencia\\nDe ${rs?rs.misses:0} días fallados, recuperaste el hábito al día siguiente ${rs?rs.bounces:0} veces (90 días)">
        <div class="label">Resiliencia</div>
        <div class="value" style="color:${rs?progressColor(rs.rate):"var(--text)"};">${rs?rs.rate:"—"}<small>${rs?"%":""}</small></div>
        <div class="sub">recuperas al día siguiente</div>
      </div>`;

    const md = computeMasterDays();
    const mdCard = `
      <div class="kpi-card" data-tip="Días maestros\\nDías de este mes con tus hábitos pilar al 100%">
        <div class="label">Días maestros</div>
        <div class="value">${md?md.count:"—"}<small>${md?` / ${md.elapsed}`:""}</small></div>
        <div class="sub">${md?"pilares al 100% este mes":"define tus pilares"}</div>
      </div>`;

    const m = computeMoM();
    const pl = shortMonth(m.prev);
    const momColor = m.relCur===null ? "var(--text)" : (m.relCur<0 ? COL.bad : COL.ok);
    const momTxt = m.relCur===null ? "—" : `${m.relCur>0?"+":""}${m.relCur.toFixed(1)}%`;
    const momCard = `
      <div class="kpi-card" data-tip="MoM\\n${shortMonth(m.cur)}: ${m.rc===null?"—":m.rc+"%"} vs ${pl}: ${m.rp===null?"—":m.rp+"%"}">
        <div class="label">MoM variación</div>
        <div class="value" style="color:${momColor};">${momTxt}</div>
        <div class="sub">vs ${pl}${m.rp!==null?` (${m.rp}%)`:""}</div>
        ${m.daysSample<7 && m.rc!==null ? `<div class="kpi-note">Muestra en estabilización (día ${m.daysSample}/7)</div>` : ""}
      </div>`;

    const info = getLeakInfo();
    let leakCard;
    if(!info || info.worst===-1){
      leakCard = `<div class="kpi-card"><div class="label">Día fuga principal</div><div class="value">—</div><div class="kpi-note">Aún sin datos suficientes</div></div>`;
    } else {
      const w = info.worst, wr = info.st.rates[w];
      const worstHab = Object.values(info.st.perHabit[w]).filter(x=>x.total>=2).map(x=>({h:x.h, r:x.done/x.total})).sort((a,b)=>a.r-b.r)[0];
      const isLeak = info.leak.includes(w);
      leakCard = `
      <div class="kpi-card" data-tip="${leakTip(info.st,w)}">
        <div class="label">Día fuga principal</div>
        <div class="value" style="font-size:22px;color:${isLeak?progressColor(wr):"var(--text)"};">${DAY_NAMES[w].charAt(0).toUpperCase()+DAY_NAMES[w].slice(1)} <small>(${wr}%)</small></div>
        <div class="sub">${isLeak && worstHab ? `${worstHab.h.icon} ${worstHab.h.name.split("(")[0].trim()}` : "Sin fuga sistemática"}</div>
      </div>`;
    }

    grid.innerHTML = globalCard + pillarCard + resCard + mdCard + momCard + leakCard;
  }

  /* ---------------- Franja horaria + fricción ---------------- */
  const CAUSES = {
    dopamina:{label:"Impulso / Evasión dopaminérgica", short:"Impulso / Evasión", color:"#ef4444"},
    energia:{label:"Baja energía / Fatiga biológica", short:"Baja energía", color:"#f59e0b"},
    multitasking:{label:"Multitasking / Sobrecarga laboral", short:"Sobrecarga laboral", color:"#64748b"},
    tiempo:{label:"Falta de tiempo / Desorganización", short:"Falta de tiempo", color:"#94a3b8"}
  };
  function causeOptions(h){ return Object.keys(CAUSES).filter(k=> k!=="dopamina" || isAbstinence(h)); }
  function causeLabel(k){ return (CAUSES[k]||{label:"—"}).label; }
  function daysBack(n){ const out=[]; const t=startOfToday(); for(let i=0;i<n;i++){ const d=new Date(t); d.setDate(d.getDate()-i); out.push(d);} return out; }
  function slotCounts(h, n){
    let am=0, pm=0;
    daysBack(n).forEach(d=>{ const k=todayKey(d); if(h.logs[k] && h.slots && h.slots[k]){ if(h.slots[k]==="am") am++; else pm++; } });
    return {am,pm};
  }
  function causeTotals(habits, n){
    const c={dopamina:0,energia:0,multitasking:0,tiempo:0};
    habits.forEach(h=>{ if(!h.causes) return; daysBack(n).forEach(d=>{ const k=todayKey(d); if(!h.logs[k] && !isRest(h,k) && c[h.causes[k]]!==undefined) c[h.causes[k]]++; }); });
    return c;
  }
  function askCause(h, key, evt){
    const tKey = todayKey(startOfToday());
    if(key>=tKey || isOffFor(h,key)) return;
    closeCausePop();
    const pop = document.createElement("div");
    pop.className = "cause-pop"; pop.id = "causePop";
    const d = new Date(key+"T00:00:00").toLocaleDateString("es-PE",{weekday:"long",day:"numeric",month:"short"});
    pop.innerHTML = `<div class="cp-t">¿Qué causó el fallo?</div><div class="cp-s"></div>` +
      causeOptions(h).map(k=>`<button data-c="${k}">${CAUSES[k].label}</button>`).join("") +
      `<button class="skip" data-c="">Omitir</button>`;
    pop.querySelector(".cp-s").textContent = `${h.name.split("(")[0].trim()} · ${d}`;
    document.body.appendChild(pop);
    const x = Math.min((evt&&evt.clientX||200), window.innerWidth-pop.offsetWidth-10);
    const y = Math.min((evt&&evt.clientY||200)+12, window.innerHeight-pop.offsetHeight-10);
    pop.style.left = Math.max(10,x)+"px"; pop.style.top = Math.max(10,y)+"px";
    pop.addEventListener("click", e=>{
      const b = e.target.closest("button"); if(!b) return;
      if(b.dataset.c){ h.causes = h.causes || {}; h.causes[key] = b.dataset.c; save(); renderInsights(); if(slideHabitId) renderSlide(); }
      closeCausePop();
    });
    setTimeout(()=>document.addEventListener("click", outsideCause, true),0);
  }
  function outsideCause(e){ const p=document.getElementById("causePop"); if(p && !p.contains(e.target)) closeCausePop(); }
  function closeCausePop(){ const p=document.getElementById("causePop"); if(p) p.remove(); document.removeEventListener("click", outsideCause, true); }
  function escAttr(t){ return String(t).replace(/"/g,"&quot;"); }

  let slotView = null;
  document.getElementById("slotBox").addEventListener("click", e=>{
    const b = e.target.closest("[data-view]"); if(!b) return;
    slotView = b.dataset.view; renderInsights();
  });
  function renderInsights(){
    const sec=document.getElementById("insightsSection"), grid=document.getElementById("insightsGrid");
    if(!state.habits.length){ sec.style.display="none"; grid.style.display="none"; return; }
    sec.style.display="flex"; grid.style.display="grid";

    // Franja: solo hábitos AM / PM / 24H según su naturaleza (los 24H no entran en AM vs PM)
    const tf = h=>h.timeframe||guessTimeframe(h.name);
    const grp = (fn)=>{ const hs=state.habits.filter(fn); const rs=hs.map(h=>({h, r:rateLastDays(h,30)})).filter(x=>x.r!==null);
      return {hs, rows:rs, rate: rs.length ? Math.round(avg(rs.map(x=>x.r))) : null}; };
    const views = {
      ampm:{name:"AM vs PM", A:{t:"AM · Ejecución mañanera", g:grp(h=>tf(h)==="am")}, B:{t:"PM · Cierre nocturno", g:grp(h=>tf(h)==="pm")},
            note:"Los hábitos 24H no entran en esta comparativa."},
      fases:{name:"Fase 1 vs 2", A:{t:"Fase 1 · 5:30–7:30", g:grp(h=>tf(h)==="am" && h.phase==="1")}, B:{t:"Fase 2 · 8:00–10:20", g:grp(h=>tf(h)==="am" && h.phase==="2")},
            note:"Solo hábitos AM con bloque asignado (✎ en el hábito)."},
      activa:{name:"Activa vs 24H", A:{t:"Ejecución activa (AM)", g:grp(h=>tf(h)==="am")}, B:{t:"Resistencia de estado (24H)", g:grp(h=>tf(h)==="24h")},
            note:"Acciones matutinas frente a disciplina pasiva del día."}
    };
    if(!slotView) slotView = views.ampm.B.g.hs.length===0 ? "activa" : "ampm";
    const v = views[slotView];
    const card = (side,color)=>`<div data-tip="${escAttr(side.t+"\n"+(side.g.hs.length)+" hábito(s) · promedio 30 días")}"><div class="k">${side.t}</div>
      <div class="v" style="color:${side.g.rate===null?"var(--text-faint)":progressColor(side.g.rate)};">${side.g.rate===null?"—":side.g.rate+"%"}</div></div>`;
    const rowsHtml = (side)=> side.g.rows.length ? side.g.rows.map(x=>`<div class="grp-row" data-tip="${escAttr(x.h.name+"\n30 días: "+x.r+"%")}">
        <span class="nm">${x.h.icon} ${x.h.name.split("(")[0].trim()}</span><div class="bar"><i style="width:${Math.max(x.r,3)}%;background:${progressColor(x.r)};"></i></div><b>${x.r}%</b></div>`).join("")
      : `<div class="empty-note">Sin hábitos en esta franja. Asígnalos con ✎.</div>`;
    let insight = "";
    if(v.A.g.rate!==null && v.B.g.rate!==null){
      const diff = v.A.g.rate - v.B.g.rate;
      insight = diff===0 ? "Ambos bloques rinden igual." : (diff>0
        ? `${v.A.t.split(" · ")[0]} rinde ${diff} puntos más que ${v.B.t.split(" · ")[0]}.`
        : `${v.B.t.split(" · ")[0]} rinde ${-diff} puntos más que ${v.A.t.split(" · ")[0]}.`);
    }
    document.getElementById("slotBox").innerHTML = `
      <div class="slot-view">${Object.keys(views).map(k=>`<button data-view="${k}" class="${k===slotView?"on":""}">${views[k].name}</button>`).join("")}</div>
      <div class="slot-big">${card(v.A)}${card(v.B)}</div>
      <div class="so-sec" style="margin-top:6px;">${v.A.t}</div>${rowsHtml(v.A)}
      <div class="so-sec">${v.B.t}</div>${rowsHtml(v.B)}
      <div class="so-note">${insight?insight+" ":""}${v.note}</div>`;

    // Fricción
    const ct = causeTotals(state.habits, 90);
    const total = Object.values(ct).reduce((a,b)=>a+b,0);
    const fr = document.getElementById("frictionBox");
    if(!total){
      fr.innerHTML = `<div class="empty-note">Aún no hay causas registradas. Al marcar un día pasado como incumplido se te preguntará el motivo; también puedes elegirlo en el registro de cada hábito (clic en la fila).</div>`;
      return;
    }
    const r=38, c=2*Math.PI*r; let acc=0;
    const segs = Object.keys(CAUSES).filter(k=>ct[k]>0).map(k=>{
      const len = ct[k]/total*c;
      const seg = `<circle class="fr-seg" cx="50" cy="50" r="${r}" fill="none" stroke="${CAUSES[k].color}" stroke-width="14"
        stroke-dasharray="${len} ${c-len}" stroke-dashoffset="${-acc}" transform="rotate(-90 50 50)" data-tip="${CAUSES[k].label}\\n${ct[k]} fallos · ${Math.round(ct[k]/total*100)}%"/>`;
      acc += len; return seg;
    }).join("");
    fr.innerHTML = `<div class="fr-wrap">
      <div style="position:relative;width:130px;height:130px;flex-shrink:0;">
        <svg viewBox="0 0 100 100" width="130" height="130"><circle cx="50" cy="50" r="${r}" fill="none" stroke="var(--surface-3)" stroke-width="14"/>${segs}</svg>
        <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none;">
          <span style="font-family:'JetBrains Mono',monospace;font-size:20px;font-weight:700;">${total}</span><span style="font-size:10px;color:var(--text-faint);">fallos</span></div>
      </div>
      <div class="fr-legend">${Object.keys(CAUSES).map(k=>`<div><i style="background:${CAUSES[k].color};"></i>${CAUSES[k].short}<b>${ct[k]}</b></div>`).join("")}</div>
    </div>`;
  }

  /* ---------------- Slide-over de hábito ---------------- */
  let slideHabitId = null;
  function openSlide(h){
    slideHabitId = h.id; renderSlide();
    document.getElementById("slideOver").classList.add("open");
    document.getElementById("slideOverlay").classList.add("open");
  }
  function closeSlide(){
    slideHabitId = null;
    document.getElementById("slideOver").classList.remove("open");
    document.getElementById("slideOverlay").classList.remove("open");
  }
  function renderSlide(){
    const h = state.habits.find(x=>x.id===slideHabitId);
    if(!h){ closeSlide(); return; }
    const today = startOfToday(), tk = todayKey(today), hs = getHabitStart(h);
    const r30 = rateLastDays(h,30), st = statusFor(r30);
    const fmt = d=>d.toLocaleDateString("es-PE",{weekday:"short",day:"numeric",month:"short"});
    const days30 = daysBack(30).reverse();
    const cells = days30.map(d=>{
      const k = todayKey(d); let cls="", txt="";
      if(isDayDisabled(k)){ cls="off"; txt="día libre"; }
      else if(isRest(h,k)){ cls="off"; txt="descanso"; }
      else if(d<hs){ cls="pre"; txt="antes del seguimiento"; }
      else if(h.logs[k]){ cls="done"; txt="cumplido"+(h.slots&&h.slots[k]?" · "+h.slots[k].toUpperCase():""); }
      else if(k===tk){ txt="pendiente"; }
      else { cls="miss"; txt="fallado"+(h.causes&&h.causes[k]?" · "+causeLabel(h.causes[k]):""); }
      return `<div class="so-cell ${cls} ${k===tk?"today":""}" data-tip="${escAttr(fmt(d)+"\\n"+txt)}"></div>`;
    }).join("");

