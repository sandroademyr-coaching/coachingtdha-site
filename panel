  function icsTrigger(offsetMinutes){
    if(offsetMinutes===0) return "PT0M";
    if(offsetMinutes % 1440 === 0) return `-P${offsetMinutes/1440}D`;
    if(offsetMinutes % 60 === 0) return `-PT${offsetMinutes/60}H`;
    return `-PT${offsetMinutes}M`;
  }
  function downloadICS(r){
    const start = new Date(r.eventDatetime);
