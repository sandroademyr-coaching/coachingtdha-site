          const c = fin.cfg;
          if(Array.isArray(d.cfg.cats) && d.cfg.cats.length){ c.cats = d.cfg.cats.slice(); cfgMsg += " Categorías: "+c.cats.length+"."; }
          if(Array.isArray(d.cfg.essCats)) c.essCats = d.cfg.essCats.slice();
          if(typeof d.cfg.cycleStart==="string") c.cycleStart = d.cfg.cycleStart;
          if(Array.isArray(d.cfg.cardCats)) c.cardCats = d.cfg.cardCats.slice();
