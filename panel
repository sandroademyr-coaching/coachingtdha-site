<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Panel TDHA — Hábitos, Agenda y Prioridades</title>
<meta name="theme-color" content="#0a0a0a">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Panel TDHA">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="icon" id="appIcon" href="data:,">
<link rel="apple-touch-icon" id="appleIcon" href="data:,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0a0a0a;
    --surface:#131313;
    --surface-2:#1a1a17;
    --surface-3:#222220;
    --border:#262620;
    --text:#ede9df;
    --text-dim:#8f8b7f;
    --text-faint:#5f5c52;
    --accent:#c9a227;
    --on-accent:#0a0a0a;
    --accent-soft:rgba(201,162,39,.12);
    --accent-soft-2:rgba(201,162,39,.28);
    --success:#3ddc84;
    --success-soft:rgba(61,220,132,.14);
    --q2:#4d9de0;
    --q2-soft:rgba(77,157,224,.14);
    --q3:#e8a33d;
    --q3-soft:rgba(232,163,61,.14);
    --q4:#7a7a7a;
    --q4-soft:rgba(122,122,122,.14);
    --radius:14px;
    --radius-sm:9px;
  }
  .made-by{
    position:fixed; left:14px; bottom:12px; z-index:40;
    font-size:10.5px; letter-spacing:0.06em; text-transform:uppercase;
    color:var(--accent); opacity:0.55; font-weight:600;
    pointer-events:none; user-select:none;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:'IBM Plex Sans',system-ui,sans-serif;
    -webkit-font-smoothing:antialiased;
    min-height:100vh;
  }
  ::selection{background:var(--accent-soft-2);}
  h1,h2,h3,.font-display{font-family:'Bebas Neue',sans-serif;font-weight:400;letter-spacing:.03em;}
  .mono{font-family:'JetBrains Mono',monospace;}
  a{color:inherit;}
  button{font-family:inherit;}
  ::-webkit-scrollbar{width:8px;height:8px;}
  ::-webkit-scrollbar-thumb{background:var(--surface-3);border-radius:8px;}
  ::-webkit-scrollbar-track{background:transparent;}

  /* ---------- Top bar ---------- */
  .topbar{
    position:sticky;top:0;z-index:50;
    display:flex;align-items:center;gap:16px;
    padding:14px 22px;
    background:rgba(13,13,13,.86);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--border);
  }
  .brand{display:flex;align-items:center;gap:10px;margin-right:6px;}
  .brand .dot{width:10px;height:10px;border-radius:50%;background:var(--accent);}
  .brand span{font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:19px;letter-spacing:.2px;}
  .tabs{display:flex;gap:4px;background:var(--surface);border:1px solid var(--border);padding:4px;border-radius:12px;}
  .tab-btn{
    border:none;background:transparent;color:var(--text-dim);
    padding:8px 16px;border-radius:9px;font-size:13.5px;font-weight:600;
    cursor:pointer;transition:.18s;letter-spacing:.1px;
  }
  .tab-btn:hover{color:var(--text);}
  .tab-btn.active{background:var(--accent);color:var(--on-accent);}
  .topbar-right{margin-left:auto;display:flex;align-items:center;gap:8px;}
  .icon-btn{
    width:36px;height:36px;border-radius:9px;border:1px solid var(--border);
    background:var(--surface);color:var(--text-dim);display:flex;align-items:center;justify-content:center;
    cursor:pointer;transition:.15s;font-size:16px;
  }
  .icon-btn:hover{color:var(--text);border-color:var(--text-faint);}
  .today-pill{
    font-family:'JetBrains Mono',monospace;font-size:11.5px;color:var(--text-dim);
    background:var(--surface);border:1px solid var(--border);padding:8px 12px;border-radius:9px;
    text-transform:capitalize;
  }

  main{max-width:1180px;margin:0 auto;padding:26px 22px 80px;}
  .view{display:none;animation:fade .25s ease;}
  .view.active{display:block;}
  @keyframes fade{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:translateY(0);}}

  .section-title{display:flex;align-items:baseline;justify-content:space-between;margin:34px 0 14px;}
  .section-title h2{font-size:16px;margin:0;font-weight:600;color:var(--text);}
  .section-title .hint{font-size:12px;color:var(--text-faint);}

  /* ---------- KPI cards ---------- */
  .kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;}
  .kpi-card{
    background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);
    padding:16px 18px;position:relative;overflow:hidden;
  }
  .kpi-card .label{font-size:11.5px;color:var(--text-dim);text-transform:uppercase;letter-spacing:.6px;font-weight:600;}
  .kpi-card .value{font-family:'JetBrains Mono',monospace;font-size:28px;font-weight:700;margin-top:8px;color:var(--text);}
  .kpi-card .value small{font-size:14px;color:var(--text-dim);font-weight:500;}
  .kpi-card .sub{font-size:11.5px;color:var(--text-faint);margin-top:4px;}
  .kpi-donut-card{align-items:flex-start;}
  .kpi-donut{position:relative;width:64px;height:64px;margin:6px 0 2px;}
  .kpi-donut svg{position:relative;z-index:1;}
  .kpi-donut-value{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    font-family:'JetBrains Mono',monospace;font-size:13px;font-weight:700;color:var(--text);z-index:1;}

  /* ---------- Habits ---------- */
  .habits-toolbar{display:flex;justify-content:space-between;align-items:center;margin-top:8px;}
  .btn{
    display:inline-flex;align-items:center;gap:7px;
    background:var(--accent);color:var(--on-accent);border:none;border-radius:9px;
    padding:9px 15px;font-size:13.5px;font-weight:600;cursor:pointer;transition:.15s;
  }
  .btn:hover{filter:brightness(1.1);}
  .btn.secondary{background:var(--surface-2);color:var(--text);border:1px solid var(--border);}
  .btn.ghost{background:transparent;color:var(--text-dim);border:1px solid var(--border);}
  .btn.small{padding:6px 11px;font-size:12.5px;}
  .btn.danger{background:transparent;color:var(--accent);border:1px solid var(--accent-soft-2);}

  .habit-list{display:flex;flex-direction:column;gap:10px;margin-top:14px;}
  .habit-row{
    background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);
    padding:14px 16px;display:grid;grid-template-columns:auto 1.6fr 1fr auto auto auto;gap:18px;align-items:center;
  }
  .habit-check{
    width:38px;height:38px;border-radius:11px;border:1.6px solid var(--border);
    background:var(--surface-2);display:flex;align-items:center;justify-content:center;
    cursor:pointer;font-size:17px;color:transparent;transition:.15s;flex-shrink:0;
  }
  .habit-check.done{background:var(--hcolor,var(--accent));border-color:var(--hcolor,var(--accent));color:#fff;}
  .habit-name{display:flex;flex-direction:column;gap:2px;min-width:0;}
  .habit-name .n{font-weight:600;font-size:14.5px;display:flex;align-items:center;gap:8px;}
  .habit-name .n .emoji{font-size:16px;}
  .habit-name .meta{font-size:11.5px;color:var(--text-faint);}
  .week-dots{display:flex;gap:5px;}
  .week-dot{
    width:20px;height:20px;border-radius:6px;background:var(--surface-2);border:1px solid var(--border);
    cursor:pointer;transition:.15s;
  }
  .week-dot.done{background:var(--hcolor,var(--accent));border-color:var(--hcolor,var(--accent));}
  .week-dot.today{outline:1.5px solid var(--text-faint);outline-offset:1px;}
  .ring-wrap{display:flex;align-items:center;gap:8px;}
  .ring-wrap svg{transform:rotate(-90deg);}
  .ring-label{font-family:'JetBrains Mono',monospace;font-size:11.5px;color:var(--text-dim);}
  .streak-chip{
    font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:700;color:var(--text);
    background:var(--surface-2);border:1px solid var(--border);padding:6px 10px;border-radius:8px;white-space:nowrap;
  }
  .row-actions{display:flex;gap:6px;}
  .icon-mini{
    width:28px;height:28px;border-radius:7px;border:1px solid var(--border);background:transparent;
    color:var(--text-faint);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:13px;transition:.15s;
  }
  .icon-mini:hover{color:var(--text);border-color:var(--text-faint);}
  .empty-state{
    text-align:center;padding:50px 20px;color:var(--text-faint);border:1px dashed var(--border);border-radius:var(--radius);margin-top:14px;
  }
  .empty-state .big{font-size:30px;margin-bottom:8px;}
  .empty-state p{font-size:13px;margin:4px 0 14px;}

  /* Heatmap */
  .heatmap-wrap{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px 20px;margin-top:12px;overflow-x:auto;}
  .heatmap-grid{display:grid;grid-auto-flow:column;grid-template-rows:repeat(7,13px);gap:3px;width:max-content;}
  .hm-cell{width:13px;height:13px;border-radius:3px;background:var(--surface-2);}
  .heatmap-legend{display:flex;align-items:center;gap:6px;margin-top:12px;font-size:11px;color:var(--text-faint);}
  .heatmap-legend .hm-cell{width:11px;height:11px;}

  /* ---------- Agenda + Eisenhower ---------- */
  .day-nav{display:flex;align-items:center;gap:10px;background:var(--surface);border:1px solid var(--border);
    border-radius:12px;padding:8px 10px;margin-bottom:6px;}
  .day-nav .date-label{font-weight:600;font-size:14px;text-transform:capitalize;flex:1;text-align:center;}
  .day-nav button{width:32px;height:32px;border-radius:8px;border:1px solid var(--border);background:var(--surface-2);color:var(--text);cursor:pointer;}
  .day-nav .today-btn{width:auto;padding:0 12px;font-size:12px;font-weight:600;color:var(--text-dim);}

  .split{display:grid;grid-template-columns:1fr 1fr;gap:22px;align-items:start;margin-top:20px;}
  @media(max-width:920px){.split{grid-template-columns:1fr;} .kpi-grid{grid-template-columns:repeat(2,1fr);} .habit-row{grid-template-columns:auto 1fr;grid-template-areas:"check name" "check dots" "check ring" "check actions";row-gap:8px;} }

  .panel-box{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px 18px 16px;}
  .panel-box h3{margin:0 0 12px;font-size:14.5px;display:flex;align-items:center;justify-content:space-between;}
  .panel-box h3 .hint{font-size:11px;color:var(--text-faint);font-weight:500;}

  /* Timeline */
  .timeline{position:relative;padding-left:18px;}
  .timeline::before{content:'';position:absolute;left:5px;top:4px;bottom:4px;width:2px;background:var(--border);}
  .tl-item{position:relative;padding:0 0 16px 18px;}
  .tl-item::before{content:'';position:absolute;left:-3.5px;top:4px;width:9px;height:9px;border-radius:50%;background:var(--tcolor,var(--accent));border:2px solid var(--bg);}
  .tl-item.status-completo .tl-card{opacity:.5;}
  .tl-item.status-completo .tl-title{text-decoration:line-through;}
  .tl-item.status-cancelado .tl-card{opacity:.4;}
  .tl-item.status-cancelado .tl-title{text-decoration:line-through;}
  .tl-item.status-reprogramado .tl-card{border-style:dashed;border-color:#4d9de066;}
  .tl-item.status-incompleto .tl-card{border-color:#e8a33d66;}
  .tl-card{background:var(--surface-2);border:1px solid var(--border);border-radius:10px;padding:10px 12px;display:flex;align-items:flex-start;gap:10px;}
  .tl-time{font-family:'JetBrains Mono',monospace;font-size:11.5px;color:var(--text-dim);width:44px;flex-shrink:0;padding-top:1px;}
  .tl-body{flex:1;min-width:0;}
  .tl-title{font-size:13.5px;font-weight:600;text-decoration:none;}
  .tl-tag{display:inline-block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;
    padding:2px 7px;border-radius:5px;margin-top:5px;background:var(--tsoft,var(--accent-soft));color:var(--tcolor,var(--accent));}
  .tl-notes{font-size:11.5px;color:var(--text-faint);margin-top:4px;}
  .tl-actions{display:flex;gap:5px;flex-shrink:0;align-items:center;}
  .tl-status-select{background:var(--surface-2);border:1px solid var(--border);border-radius:6px;
    font-size:10.5px;font-weight:700;padding:4px 6px;font-family:inherit;cursor:pointer;}

  .add-inline{display:flex;gap:8px;margin-top:12px;}
  .add-inline input, .add-inline select{
    background:var(--surface-2);border:1px solid var(--border);color:var(--text);
    border-radius:8px;padding:8px 10px;font-size:12.5px;font-family:inherit;
  }

  /* Eisenhower */
  .eisen-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  .quad{border-radius:12px;padding:14px;min-height:190px;display:flex;flex-direction:column;border:1px solid var(--border);}
  .quad.q1{background:var(--accent-soft);border-color:var(--accent-soft-2);}
  .quad.q2{background:var(--q2-soft);border-color:rgba(77,157,224,.35);}
  .quad.q3{background:var(--q3-soft);border-color:rgba(232,163,61,.35);}
  .quad.q4{background:var(--q4-soft);border-color:rgba(122,122,122,.35);}
  .quad-title{font-size:12.5px;font-weight:700;}
  .quad.q1 .quad-title{color:var(--accent);}
  .quad.q2 .quad-title{color:var(--q2);}
  .quad.q3 .quad-title{color:var(--q3);}
  .quad.q4 .quad-title{color:var(--q4);}
  .quad-sub{font-size:10.5px;color:var(--text-faint);margin-top:1px;margin-bottom:10px;}
  .quad-list{display:flex;flex-direction:column;gap:6px;flex:1;}
  .qtask{display:flex;align-items:flex-start;gap:8px;background:var(--surface);border:1px solid var(--border);
    border-radius:8px;padding:7px 9px;font-size:12.5px;}
  .qtask input[type=checkbox]{margin-top:2px;accent-color:var(--accent);}
  .qtask.done span{text-decoration:line-through;color:var(--text-faint);}
  .qtask .del{margin-left:auto;cursor:pointer;color:var(--text-faint);font-size:12px;}
  .qtask .del:hover{color:var(--accent);}
  .quad-add{display:flex;gap:6px;margin-top:8px;}
  .quad-add input{flex:1;background:var(--surface);border:1px solid var(--border);color:var(--text);
    border-radius:7px;padding:7px 9px;font-size:12px;}
  .quad-add button{background:var(--surface-3);border:1px solid var(--border);color:var(--text);border-radius:7px;
    width:30px;cursor:pointer;font-size:14px;}

  /* ---------- Modal ---------- */
  .modal-overlay{
    position:fixed;inset:0;background:rgba(10,10,10,.6);backdrop-filter:blur(6px);
    display:none;align-items:center;justify-content:center;z-index:100;padding:20px;
  }
  .modal-overlay.open{display:flex;}
  .modal{background:rgba(19,19,19,.85);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid var(--border);border-radius:16px;padding:22px;width:100%;max-width:420px;box-shadow:0 24px 60px -12px rgba(0,0,0,.7);}
  .modal h3{margin:0 0 16px;font-size:15px;}
  .field{margin-bottom:12px;}
  .field label{display:block;font-size:11.5px;color:var(--text-dim);margin-bottom:5px;font-weight:600;text-transform:uppercase;letter-spacing:.4px;}
  .field input, .field select{
    width:100%;background:var(--surface-2);border:1px solid var(--border);color:var(--text);
    padding:9px 11px;border-radius:8px;font-size:13.5px;font-family:inherit;
  }
  .field-row{display:flex;gap:10px;}
  .field-row .field{flex:1;}
  .swatches{display:flex;gap:8px;flex-wrap:wrap;}
  .swatch{width:26px;height:26px;border-radius:50%;cursor:pointer;border:2px solid transparent;}
  .swatch.sel{border-color:#fff;}
  .emoji-grid{display:flex;gap:6px;flex-wrap:wrap;}
  .emoji-opt{width:32px;height:32px;border-radius:8px;background:var(--surface-2);border:1px solid var(--border);
    display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:16px;}
  .emoji-opt.sel{border-color:var(--accent);background:var(--accent-soft);}
  .modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:18px;}

  /* ---------- Estadísticas de hábitos ---------- */
  .stats-table{width:100%;border-collapse:collapse;font-size:12.5px;}
  .stats-table th{text-align:left;color:var(--text-faint);font-weight:600;text-transform:uppercase;
    letter-spacing:.4px;font-size:10.5px;padding:0 10px 8px;border-bottom:1px solid var(--border);}
  .stats-table td{padding:9px 10px;border-bottom:1px solid var(--border);}
  .stats-table tr:last-child td{border-bottom:none;}
  .stats-habit{display:flex;align-items:center;gap:8px;font-weight:600;}
  .bar-track{width:100%;height:6px;background:var(--surface-2);border-radius:4px;overflow:hidden;}
  .bar-fill{height:100%;border-radius:4px;background:var(--accent);}
  .mono-num{font-family:'JetBrains Mono',monospace;}

  .backfill-row{display:flex;align-items:center;gap:10px;background:var(--surface-2);border:1px solid var(--border);
    border-radius:9px;padding:8px 10px;cursor:pointer;transition:.15s;}
  .backfill-row:hover{border-color:var(--text-faint);}

  .backfill-tabs{display:flex;gap:4px;background:var(--surface-2);border:1px solid var(--border);
    padding:3px;border-radius:9px;margin-bottom:16px;}
  .backfill-tab-btn{flex:1;border:none;background:transparent;color:var(--text-dim);
    padding:7px;border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;transition:.15s;}
  .backfill-tab-btn.active{background:var(--accent);color:var(--on-accent);}

  .cal-nav{display:flex;align-items:center;gap:8px;margin-bottom:12px;}
  .cal-nav button{width:28px;height:28px;border-radius:7px;border:1px solid var(--border);
    background:var(--surface-2);color:var(--text);cursor:pointer;flex-shrink:0;}
  .cal-nav .cal-month-label{flex:1;text-align:center;font-weight:600;font-size:13px;text-transform:capitalize;}
  .cal-nav .cal-today-btn{width:auto;padding:0 10px;font-size:11px;color:var(--text-dim);}
  .cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;}
  .cal-wd{font-size:10px;color:var(--text-faint);text-align:center;font-weight:700;padding-bottom:4px;}
  .cal-day{aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:8px;
    background:var(--surface-2);border:1px solid var(--border);font-size:11.5px;cursor:pointer;
    transition:.15s;color:var(--text-dim);}
  .cal-day.empty{background:transparent;border:none;cursor:default;}
  .cal-day.future{opacity:.3;cursor:default;}
  .cal-day.done{background:var(--hcolor,var(--accent));border-color:var(--hcolor,var(--accent));color:#fff;font-weight:700;}
  .cal-day.today:not(.done){outline:1.5px solid var(--text-faint);outline-offset:1px;}
  .cal-day:hover:not(.future):not(.empty):not(.done){border-color:var(--text-faint);}
  .cal-stats-row{display:flex;align-items:center;justify-content:space-between;margin-top:12px;}
  .cal-stats-row .stat{font-size:11.5px;color:var(--text-dim);}

  /* ---------- Tendencia de productividad ---------- */
  .prod-bars{display:flex;align-items:flex-end;gap:6px;height:70px;}
  .prod-bar{width:16px;border-radius:4px 4px 0 0;background:var(--surface-2);min-height:4px;transition:.2s;}
  .prod-bar.has-data{background:var(--accent);}
  .prod-labels{display:flex;justify-content:space-between;margin-top:6px;font-size:10px;color:var(--text-faint);}

  /* ---------- Días deshabilitados (vacaciones/feriados) ---------- */
  .dayoff-banner{background:var(--surface-2);border:1px dashed var(--text-faint);border-radius:10px;
    padding:11px 14px;font-size:12.5px;color:var(--text-dim);margin-top:10px;display:flex;align-items:center;gap:8px;}
  .week-dot.off{border-style:dashed;opacity:.5;background:repeating-linear-gradient(45deg,var(--surface-2),var(--surface-2) 2px,var(--surface-3) 2px,var(--surface-3) 4px);}
  .cal-day.off{opacity:.55;border-style:dashed;}
  .hm-cell.off{background:repeating-linear-gradient(45deg,var(--surface-2),var(--surface-2) 3px,var(--surface-3) 3px,var(--surface-3) 6px)!important;}

  /* ---------- Comparativa de hábitos (dashboard) ---------- */
  .cmp-row{display:flex;align-items:center;gap:12px;padding:8px 0;}
  .cmp-rank{width:20px;flex-shrink:0;text-align:center;font-size:13px;}
  .cmp-label{width:150px;flex-shrink:0;font-size:12.5px;font-weight:600;overflow:hidden;
    text-overflow:ellipsis;white-space:nowrap;display:flex;align-items:center;gap:6px;}
  .cmp-bar-track{flex:1;height:22px;background:var(--surface-2);border-radius:6px;position:relative;overflow:hidden;}
  .cmp-bar-fill{height:100%;border-radius:6px;transition:width .3s;}
  .cmp-bar-value{position:absolute;right:8px;top:50%;transform:translateY(-50%);
    font-size:11px;font-family:'JetBrains Mono',monospace;font-weight:700;color:#fff;text-shadow:0 1px 2px rgba(0,0,0,.4);}

  /* ---------- Profundidad / micro-interacciones ---------- */
  .kpi-card,.habit-row,.tmd-item,.cmp-row{transition:all .25s cubic-bezier(.4,0,.2,1);}
  .kpi-card:hover,.habit-row:hover{transform:translateY(-4px);
    box-shadow:0 12px 28px -8px rgba(0,0,0,.6),0 0 0 1px rgba(255,255,255,.15);}
  .habit-row{cursor:pointer;}
  .dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--c);margin-right:5px;vertical-align:middle;position:relative;}
  .dot.pulse::after{content:'';position:absolute;inset:0;border-radius:50%;background:var(--c);animation:dotPulse 1.8s ease-out infinite;}
  @keyframes dotPulse{0%{transform:scale(1);opacity:.7}100%{transform:scale(3.2);opacity:0}}
  .status-txt .dot{font-size:0;}
  .rich-tip{position:fixed;z-index:400;pointer-events:none;max-width:260px;padding:9px 12px;border-radius:10px;font-size:12px;line-height:1.5;
    background:rgba(19,19,19,.88);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.14);
    box-shadow:0 12px 28px -8px rgba(0,0,0,.7);color:var(--text-dim);opacity:0;transform:translateY(4px);transition:opacity .15s,transform .15s;}
  .rich-tip.show{opacity:1;transform:none;}
  .rich-tip b{color:var(--text);display:block;font-weight:600;}

  /* ---------- Slide-over ---------- */
  .slide-overlay{position:fixed;inset:0;background:rgba(10,10,10,.55);backdrop-filter:blur(4px);z-index:150;opacity:0;pointer-events:none;transition:opacity .25s;}
  .slide-overlay.open{opacity:1;pointer-events:auto;}
  .slide-over{position:fixed;top:0;right:0;bottom:0;width:min(460px,100vw);z-index:160;overflow-y:auto;padding:22px;
    background:rgba(19,19,19,.92);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-left:1px solid rgba(255,255,255,.1);
    transform:translateX(102%);transition:transform .3s cubic-bezier(.4,0,.2,1);box-shadow:-24px 0 60px -12px rgba(0,0,0,.6);}
  .slide-over.open{transform:none;}
  .so-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:16px;}
  .so-title{font-family:'Bebas Neue',sans-serif;font-size:26px;font-weight:400;display:flex;gap:10px;align-items:center;}
  .so-sub{font-size:11.5px;color:var(--text-faint);margin-top:3px;}
  .so-close{width:32px;height:32px;border-radius:8px;border:1px solid var(--border);background:var(--surface-2);color:var(--text-dim);cursor:pointer;flex-shrink:0;}
  .so-close:hover{color:var(--text);}
  .so-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:6px;}
  .so-stat{background:var(--surface-2);border:1px solid var(--border);border-radius:10px;padding:10px 12px;}
  .so-stat .k{font-size:10px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.5px;font-weight:600;}
  .so-stat .v{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:18px;margin-top:3px;}
  .so-sec{font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--text-dim);font-weight:700;margin:20px 0 10px;}
  .so-hm{display:grid;grid-template-columns:repeat(10,1fr);gap:5px;}
  .so-cell{aspect-ratio:1;border-radius:5px;background:var(--surface-3);}
  .so-cell.done{background:var(--ok,#10b981);}
  .so-cell.miss{background:rgba(239,68,68,.35);}
  .so-cell.pre{opacity:.25;}
  .so-cell.off{background:repeating-linear-gradient(45deg,var(--surface-2),var(--surface-2) 3px,var(--surface-3) 3px,var(--surface-3) 6px);}
  .so-cell.today{outline:1px solid rgba(255,255,255,.4);}
  .so-log{display:flex;flex-direction:column;gap:6px;}
  .so-log-row{display:flex;align-items:center;justify-content:space-between;gap:8px;background:var(--surface-2);border:1px solid var(--border);border-radius:9px;padding:7px 10px;font-size:12px;}
  .so-log-row .d{color:var(--text-dim);text-transform:capitalize;min-width:92px;}
  .seg{display:flex;gap:4px;}
  .seg button{background:transparent;border:1px solid var(--border);color:var(--text-faint);border-radius:6px;padding:3px 10px;font-size:11px;font-weight:700;cursor:pointer;transition:all .2s;}
  .seg button.on{background:var(--surface-3);color:var(--text);border-color:rgba(255,255,255,.25);}
  .so-log select{background:var(--surface-3);border:1px solid var(--border);color:var(--text);border-radius:6px;padding:4px 6px;font-size:11.5px;max-width:170px;}
  .so-note{font-size:11px;color:var(--text-faint);line-height:1.5;margin-top:8px;}

  .cause-pop{position:fixed;z-index:450;width:260px;padding:12px;border-radius:12px;background:rgba(19,19,19,.92);
    backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.14);box-shadow:0 16px 40px -8px rgba(0,0,0,.7);}
  .cause-pop .cp-t{font-size:12px;font-weight:700;margin-bottom:2px;}
  .cause-pop .cp-s{font-size:11px;color:var(--text-faint);margin-bottom:8px;text-transform:capitalize;}
  .cause-pop button{display:block;width:100%;text-align:left;background:var(--surface-2);border:1px solid var(--border);color:var(--text);
    border-radius:8px;padding:8px 10px;font-size:12px;margin-top:5px;cursor:pointer;transition:all .2s;}
  .cause-pop button:hover{border-color:rgba(255,255,255,.3);transform:translateX(2px);}
  .cause-pop button.skip{background:transparent;color:var(--text-faint);}
  .slot-view{display:flex;gap:4px;margin-bottom:14px;flex-wrap:wrap;}
  .slot-view button{background:transparent;border:1px solid var(--border);color:var(--text-faint);border-radius:7px;padding:4px 10px;font-size:11px;font-weight:600;cursor:pointer;transition:all .2s;}
  .slot-view button.on{background:var(--surface-3);color:var(--text);border-color:rgba(255,255,255,.25);}
  .grp-row{display:flex;align-items:center;gap:8px;font-size:11.5px;padding:4px 0;color:var(--text-dim);}
  .grp-row .nm{width:120px;flex-shrink:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .grp-row .bar{flex:1;height:6px;background:var(--surface-3);border-radius:4px;overflow:hidden;}
  .grp-row .bar i{display:block;height:100%;border-radius:4px;transition:width .5s cubic-bezier(.4,0,.2,1);}
  .grp-row b{width:36px;text-align:right;font-family:'JetBrains Mono',monospace;color:var(--text);}

  /* ---------- Cuenta / sincronización ---------- */
  .sync-pill{display:flex;align-items:center;gap:7px;height:36px;padding:0 12px;border-radius:9px;border:1px solid var(--border);
    background:var(--surface);color:var(--text-dim);font-size:11.5px;font-weight:600;cursor:pointer;transition:.15s;white-space:nowrap;}
  .sync-pill:hover{color:var(--text);border-color:var(--text-faint);}
  .sync-pill .dot{margin:0;}
  .auth-screen{position:fixed;inset:0;z-index:500;background:radial-gradient(1200px 600px at 50% -10%,rgba(201,162,39,.10),transparent),#0a0a0a;
    display:flex;align-items:center;justify-content:center;padding:20px;overflow-y:auto;}
  .auth-card{width:100%;max-width:400px;background:rgba(19,19,19,.94);border:1px solid #262620;border-radius:18px;padding:28px;
    box-shadow:0 24px 60px -12px rgba(0,0,0,.7);}
  .auth-logo{font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:22px;display:flex;align-items:center;gap:10px;margin-bottom:6px;}
  .auth-logo .dot{width:10px;height:10px;border-radius:50%;background:var(--accent);display:inline-block;}
  .auth-sub{font-size:12.5px;color:var(--text-dim);margin-bottom:18px;line-height:1.5;}
  .auth-tabs{display:flex;gap:4px;background:var(--surface-2);border:1px solid var(--border);padding:4px;border-radius:11px;margin-bottom:16px;}
  .auth-tabs button{flex:1;border:none;background:transparent;color:var(--text-dim);padding:9px;border-radius:8px;font-weight:600;font-size:13px;cursor:pointer;}
  .auth-tabs button.on{background:var(--surface-3);color:var(--text);}
  .pw-wrap{position:relative;}
  .pw-wrap input{padding-right:42px;}
  .pw-wrap button{position:absolute;right:4px;top:50%;transform:translateY(-50%);background:transparent;border:none;cursor:pointer;font-size:16px;padding:6px 8px;opacity:.7;}
  .auth-err{min-height:18px;font-size:12px;color:#ef4444;margin-top:2px;line-height:1.4;}
  .auth-err.ok{color:#10b981;}
  .auth-links{display:flex;justify-content:space-between;gap:10px;margin-top:16px;font-size:12px;}
  .auth-links a{color:var(--text-faint);text-decoration:none;}
  .auth-links a:hover{color:var(--text);}
  .tab-btn .ti{display:none;}
  .tab-btn .tl .short{display:none;}

  /* ---------- Móvil ---------- */
  @media(max-width:720px){
    .topbar{padding:10px 14px;gap:8px;backdrop-filter:none;-webkit-backdrop-filter:none;background:rgba(10,10,10,.97);}
    .brand span:last-child{font-size:13px;}
    .today-pill{display:none;}
    .icon-btn{width:40px;height:40px;}
    .sync-pill{height:40px;padding:0 11px;}
    #syncText{display:none;}
    #mainTabs{position:fixed;left:0;right:0;bottom:0;z-index:60;border-radius:0;border:none;border-top:1px solid var(--border);
      background:rgba(19,19,19,.94);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
      padding:6px 8px calc(6px + env(safe-area-inset-bottom));justify-content:space-around;gap:4px;order:5;}
    #mainTabs .tab-btn{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:7px 4px;font-size:10.5px;border-radius:12px;}
    #mainTabs .tab-btn .ti{display:block;font-size:19px;line-height:1;}
    #mainTabs .tab-btn .tl .full{display:none;}
    #mainTabs .tab-btn .tl .short{display:inline;}
    #mainTabs .tab-btn.active{background:var(--accent-soft);color:var(--text);}
    main{padding:16px 14px calc(96px + env(safe-area-inset-bottom));}
    .section-title{margin:26px 0 12px;flex-wrap:wrap;gap:4px;}
    .kpi-card{padding:14px;}
    .kpi-card .value{font-size:24px;}
    .modal-overlay{align-items:flex-end;padding:0;}
    .modal{max-width:100%!important;border-radius:18px 18px 0 0;max-height:92vh;overflow-y:auto;padding:20px 18px calc(20px + env(safe-area-inset-bottom));}
    .settings-pop{position:fixed;left:10px;right:10px;top:64px;width:auto;max-height:calc(100vh - 90px);overflow-y:auto;}
    .toast{bottom:92px;max-width:92vw;text-align:center;}
    input,select,textarea,.field input,.field select{font-size:16px!important;}
    .day-nav{flex-wrap:wrap;}
    #periodTabs .tab-btn{padding:9px 2px;font-size:12px;}
    .blk-row{grid-template-columns:1fr 1fr;}
    .blk-row input[data-f="icon"]{grid-column:1;}
    .blk-row input[data-f="title"]{grid-column:1 / -1;}
    .tl-card{flex-wrap:wrap;}
    .tl-actions{width:100%;justify-content:flex-end;}
    .cap-grid{grid-template-columns:44px repeat(7,1fr);gap:3px;}
    .cap-cell{height:26px;font-size:9px;}
    .rk-in{font-size:16px;}
    .quick-btn{padding:10px 12px;}
    .eisen-grid{grid-template-columns:1fr!important;}
    .quad{min-width:0;}
  }
  @media(hover:none){
    .kpi-card:hover,.habit-row:hover,.intel-card:hover,.quick-btn:hover{transform:none;box-shadow:none;}
  }

  /* ---------- Agenda cero fricción ---------- */
  .rocks-card{margin-top:16px;border-radius:14px;padding:18px;background:linear-gradient(180deg,#171714,#131313);
    border:1px solid rgba(255,255,255,.1);transition:all .25s cubic-bezier(.4,0,.2,1);}
  .rocks-card:hover{border-color:rgba(255,255,255,.18);}
  .rocks-title{font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:18px;margin-bottom:12px;display:flex;gap:10px;align-items:baseline;flex-wrap:wrap;}
  .rocks-title span{font-family:'IBM Plex Sans',sans-serif;font-weight:500;font-size:11.5px;color:var(--text-faint);}
  .rock{display:flex;align-items:center;gap:12px;padding:8px 0;}
  .rock+.rock{border-top:1px solid rgba(255,255,255,.05);}
  .rk-n{font-family:'JetBrains Mono',monospace;font-weight:700;color:var(--text-faint);width:14px;}
  .rock input[type=checkbox]{width:20px;height:20px;accent-color:#10b981;cursor:pointer;flex-shrink:0;}
  .rk-in{flex:1;background:transparent;border:none;border-bottom:1px solid transparent;color:var(--text);font-size:14.5px;padding:6px 2px;outline:none;transition:border-color .2s;}
  .rk-in:focus{border-bottom-color:rgba(255,255,255,.25);}
  .rk-in::placeholder{color:var(--text-faint);}
  .rock.done .rk-in{text-decoration:line-through;color:var(--text-faint);}
  .quick-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px;}
  .quick-btn{background:var(--surface-2);border:1px solid var(--border);color:var(--text);border-radius:9px;padding:8px 12px;font-size:12.5px;font-weight:600;cursor:pointer;transition:all .25s cubic-bezier(.4,0,.2,1);}
  .quick-btn:hover{transform:translateY(-2px);border-color:rgba(255,255,255,.25);}
  .quick-btn small{color:var(--text-faint);font-weight:500;margin-left:4px;}
  .quick-btn.ghost{background:transparent;color:var(--text-dim);border-style:dashed;}
  .tl-item.fixed .tl-card{background:rgba(255,255,255,.025);}
  .tl-item.fixed.respected .tl-card{border-color:rgba(16,185,129,.35);}
  .tl-item.fixed.respected .tl-title{color:var(--text-dim);}
  .tl-item.fixed.now .tl-card{border-color:rgba(255,255,255,.28);}
  .tl-item.fixed .tl-tag{background:rgba(255,255,255,.05);color:var(--text-faint);}
  .tl-item.fixed.respected .tl-tag{color:#10b981;background:rgba(16,185,129,.1);}
  .blk-check{width:24px;height:24px;border-radius:7px;border:1.5px solid var(--border);background:transparent;color:#fff;cursor:pointer;flex-shrink:0;font-size:13px;transition:all .2s;}
  .blk-check.on{background:#10b981;border-color:#10b981;}
  .tl-time-input{width:104px;flex-shrink:0;background:transparent;border:1px solid transparent;color:var(--text-dim);
    font-family:'JetBrains Mono',monospace;font-size:11.5px;border-radius:6px;padding:2px 4px;}
  .tl-time-input:hover,.tl-time-input:focus{border-color:var(--border);background:var(--surface-3);}
  .tl-range{width:84px;flex-shrink:0;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--text-dim);padding-top:2px;line-height:1.5;}
  .blk-row{display:grid;grid-template-columns:90px 90px 48px 1fr auto auto;gap:6px;align-items:center;margin-bottom:6px;}
  .blk-row input[type=time],.blk-row input[type=text]{background:var(--surface-2);border:1px solid var(--border);color:var(--text);border-radius:7px;padding:7px 8px;font-size:12.5px;width:100%;}
  .blk-row label{font-size:10.5px;color:var(--text-faint);display:flex;gap:4px;align-items:center;white-space:nowrap;}
  .cap-grid{display:grid;grid-template-columns:64px repeat(7,1fr);gap:5px;align-items:center;}
  .cap-h{font-size:11px;font-weight:700;color:var(--text-faint);text-align:center;padding:2px 0;}
  .cap-wk{font-size:10.5px;color:var(--text-faint);}
  .cap-cell{height:30px;border-radius:7px;background:var(--surface-3);display:flex;align-items:center;justify-content:center;font-size:10.5px;
    font-family:'JetBrains Mono',monospace;font-weight:700;color:#fff;transition:transform .2s;}
  .cap-cell:hover{transform:scale(1.06);}
  .cap-cell.empty{background:transparent;border:1px dashed rgba(255,255,255,.06);}
  .cap-cell.warn{outline:1.5px dashed #f59e0b;outline-offset:1px;}
  .cap-avg{margin-top:4px;}
  .cap-h.warn{color:#f59e0b;}

  /* ---------- Centro de inteligencia ---------- */
  .intel-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;}
  @media(max-width:920px){.intel-grid{grid-template-columns:1fr;}}
  .intel-card{background:#161824;border:1px solid rgba(255,255,255,.05);border-radius:14px;padding:16px;transition:all .25s cubic-bezier(.4,0,.2,1);min-width:0;}
  .intel-card:hover{transform:translateY(-2px);border-color:rgba(255,255,255,.15);}
  .intel-h{display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-bottom:12px;}
  .intel-h b{font-size:12.5px;font-weight:700;}
  .intel-h span{font-size:10.5px;color:var(--text-faint);}
  .mom-row,.spk-row{display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid rgba(255,255,255,.04);font-size:12.5px;}
  .mom-row:last-child,.spk-row:last-child{border-bottom:none;}
  .mom-row .nm,.spk-row .nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:600;}
  .mom-row .dl{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:13px;min-width:64px;text-align:right;}
  .mom-row .tx{font-size:10.5px;color:var(--text-faint);width:110px;text-align:right;}
  .spk-row svg{flex-shrink:0;}
  .spk-row b{font-family:'JetBrains Mono',monospace;width:38px;text-align:right;font-size:12px;}
  .qual-bar{display:flex;height:12px;border-radius:7px;overflow:hidden;gap:2px;margin:4px 0 14px;}
  .qual-bar i{display:block;transition:flex .5s cubic-bezier(.4,0,.2,1);min-width:3px;}
  .qual-row{display:flex;align-items:center;gap:9px;padding:6px 0;font-size:12.5px;color:var(--text-dim);}
  .qual-row i{width:9px;height:9px;border-radius:3px;flex-shrink:0;}
  .qual-row b{margin-left:auto;font-family:'JetBrains Mono',monospace;color:var(--text);}
  .qual-row small{color:var(--text-faint);font-size:10.5px;}
  .dom-item{display:flex;gap:10px;align-items:flex-start;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.04);font-size:12.5px;line-height:1.5;color:var(--text-dim);}
  .dom-item:last-child{border-bottom:none;}
  .dom-item .bd{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:11.5px;padding:2px 7px;border-radius:6px;background:var(--surface-3);flex-shrink:0;}
  .dom-item b{color:var(--text);font-weight:600;}

  /* ---------- Insights (franja / fricción) ---------- */
  .insights-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  @media(max-width:920px){.insights-grid{grid-template-columns:1fr;}}
  .slot-big{display:flex;gap:12px;margin-bottom:14px;}
  .slot-big>div{flex:1;background:var(--surface-2);border:1px solid var(--border);border-radius:12px;padding:12px 14px;}
  .slot-big .k{font-size:10.5px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.5px;font-weight:600;}
  .slot-big .v{font-family:'JetBrains Mono',monospace;font-size:24px;font-weight:700;margin-top:4px;}
  .slot-row{padding:7px 0;}
  .slot-row .nm{font-size:12px;font-weight:600;margin-bottom:5px;}
  .slot-bar{display:flex;align-items:center;gap:8px;margin-bottom:3px;font-size:10.5px;color:var(--text-faint);}
  .slot-bar i{display:block;height:7px;border-radius:4px;min-width:3px;transition:width .5s cubic-bezier(.4,0,.2,1);}
  .slot-bar span{width:22px;font-weight:700;}
  .fr-wrap{display:flex;gap:18px;align-items:center;flex-wrap:wrap;}
  .fr-legend{display:flex;flex-direction:column;gap:8px;font-size:12px;flex:1;min-width:150px;}
  .fr-legend div{display:flex;align-items:center;gap:8px;color:var(--text-dim);}
  .fr-legend i{width:9px;height:9px;border-radius:3px;flex-shrink:0;}
  .fr-legend b{margin-left:auto;font-family:'JetBrains Mono',monospace;color:var(--text);}
  .fr-seg{transition:stroke-width .2s;cursor:pointer;}
  .fr-seg:hover{stroke-width:18;}
  .empty-note{font-size:12px;color:var(--text-faint);line-height:1.6;padding:6px 0;}

  /* ---------- Pipeline de hábitos (niveles) ---------- */
  .tier-head{display:flex;align-items:center;gap:10px;margin:18px 0 2px;padding:0 4px;}
  .tier-head:first-child{margin-top:14px;}
  .tier-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}
  .tier-title{font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:16px;letter-spacing:.5px;text-transform:uppercase;}
  .tier-sub{font-size:11.5px;color:var(--text-faint);}
  .tier-avg{margin-left:auto;font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:700;}
  .status-pill{display:inline-block;font-size:9.5px;font-weight:800;letter-spacing:.5px;padding:2px 7px;border-radius:5px;margin-left:6px;vertical-align:middle;}
  .pillar-tag{font-size:9.5px;font-weight:800;letter-spacing:.5px;color:var(--accent);border:1px solid var(--accent-soft-2);
    background:var(--accent-soft);padding:1px 6px;border-radius:5px;margin-left:6px;}
  .kpi-lines{margin-top:6px;display:flex;flex-direction:column;gap:2px;}
  .kpi-lines div{font-size:11px;color:var(--text-dim);display:flex;justify-content:space-between;gap:8px;}
  .kpi-lines b{font-family:'JetBrains Mono',monospace;font-weight:700;}
  .kpi-warn{font-size:11px;color:#ff8a5c;margin-top:6px;line-height:1.4;}

  .status-txt{font-size:10.5px;color:var(--text-faint);margin-left:8px;white-space:nowrap;}
  .status-txt span{font-size:9px;}
  .pillar-mark{font-size:8px;color:var(--text-faint);margin-left:7px;vertical-align:middle;}
  .kpi-note{font-size:10.5px;color:var(--text-faint);margin-top:6px;}
  .cmp-bar-value{text-shadow:none!important;}
  .emoji,.cmp-label>span:first-child{display:inline-flex;width:22px;justify-content:center;font-size:16px;line-height:1;}
  #diagUse1,#diagUse3{background:var(--surface-2);border:1px solid var(--border);color:var(--text-dim);}
  #diagUse1:hover,#diagUse3:hover{color:var(--text);}

  /* ---------- Día fuga ---------- */
  .leak-plot{position:relative;height:150px;display:flex;gap:12px;align-items:flex-end;padding:0 4px;}
  .leak-col{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;}
  .leak-bar{width:100%;max-width:56px;border-radius:7px 7px 3px 3px;min-height:4px;transition:height .5s cubic-bezier(.4,0,.2,1);}
  .leak-val{font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:700;margin-bottom:5px;color:var(--text);}
  .leak-avg{position:absolute;left:0;right:0;border-top:1.5px dashed var(--text-faint);pointer-events:none;}
  .leak-avg span{position:absolute;right:0;top:-16px;font-size:10px;color:var(--text-faint);background:var(--surface);padding:0 4px;}
  .leak-labels{display:flex;gap:12px;padding:6px 4px 0;}
  .leak-labels div{flex:1;text-align:center;font-size:11.5px;font-weight:700;color:var(--text-dim);}
  .leak-labels div.leak{color:var(--accent);}
  .leak-alert{margin-top:16px;border-radius:10px;padding:12px 14px;font-size:12.5px;line-height:1.55;
    border:1px solid var(--border);background:var(--surface-2);color:var(--text-dim);}
  .leak-alert b{color:var(--text);}
  .leak-alert.bad{border-left:3px solid var(--accent);}
  .leak-alert.good{border-left:3px solid #10b981;}

  /* ---------- Diagnóstico ---------- */
  .diag-q{padding:14px 0;border-bottom:1px solid var(--border);}
  .diag-q:last-child{border-bottom:none;padding-bottom:0;}
  .diag-q:first-child{padding-top:0;}
  .diag-q-title{font-weight:600;font-size:13.5px;margin-bottom:6px;}
  .diag-suggest{font-size:11.5px;color:var(--text-dim);margin-bottom:8px;line-height:1.5;display:flex;gap:10px;align-items:flex-start;justify-content:space-between;}
  .diag-target-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;}
  .diag-target-row input{width:92px;background:var(--surface-2);border:1px solid var(--border);color:var(--text);
    border-radius:8px;padding:9px 11px;font-size:14px;font-family:'JetBrains Mono',monospace;font-weight:700;}

  /* ---------- Tendencia mensual ---------- */
  .trend-chart-wrap{animation:trendFadeIn .5s ease;}
  @keyframes trendFadeIn{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}
  .trend-dot{transition:r .15s ease, filter .15s ease;cursor:pointer;}
  .trend-dot:hover{filter:drop-shadow(0 0 6px var(--accent));}
  .trend-line-path{transition:stroke-dashoffset 1s cubic-bezier(.4,0,.2,1);}

  .trend-month-donuts{display:flex;gap:8px;flex-wrap:wrap;justify-content:space-between;margin-top:22px;}
  .tmd-item{display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer;
    padding:10px 6px;border-radius:12px;transition:.15s;flex:1;min-width:72px;border:1px solid transparent;}
  .tmd-item:hover{background:var(--surface-2);}
  .tmd-item.active{background:var(--accent-soft);border-color:var(--accent-soft-2);}
  .tmd-label{font-size:11px;color:var(--text-dim);text-transform:capitalize;font-weight:600;}
  .tmd-donut{position:relative;width:52px;height:52px;}
  .tmd-donut-value{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    font-family:'JetBrains Mono',monospace;font-size:11px;font-weight:700;color:var(--text);}
  .tmd-empty{opacity:.35;}

  .month-detail-panel{margin-top:20px;border-top:1px solid var(--border);padding-top:16px;
    animation:trendFadeIn .3s ease;}
  .month-detail-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;}
  .month-detail-header .mdh-title{font-weight:600;font-size:13.5px;text-transform:capitalize;}
  .month-detail-header .mdh-sub{font-size:11px;color:var(--text-faint);font-weight:500;text-transform:none;}
  .month-detail-grid{display:flex;flex-wrap:wrap;gap:18px;}
  .mdg-item{display:flex;flex-direction:column;align-items:center;gap:7px;width:82px;}
  .mdg-donut{position:relative;width:60px;height:60px;}
  .mdg-donut-value{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:700;color:var(--text);}
  .mdg-label{font-size:10.5px;color:var(--text-dim);text-align:center;display:flex;align-items:center;
    justify-content:center;gap:3px;line-height:1.3;}

  /* ---------- Objetivos por período (estilo CRM) ---------- */
  .status-badge{display:inline-block;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;
    padding:3px 8px;border-radius:5px;}
  .obj-updates::-webkit-scrollbar{width:5px;}

  /* ---------- Recordatorios ---------- */
  .reminder-row{display:flex;align-items:center;gap:10px;background:var(--surface-2);border:1px solid var(--border);
    border-radius:9px;padding:8px 10px;}

  /* ---------- Journal ---------- */
  .journal-textarea{width:100%;background:var(--surface-2);border:1px solid var(--border);color:var(--text);
    border-radius:8px;padding:10px 12px;font-family:inherit;font-size:13.5px;resize:vertical;line-height:1.5;}
  .journal-card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:12px 14px;
    cursor:pointer;display:flex;gap:12px;align-items:flex-start;transition:.15s;}
  .journal-card:hover{border-color:var(--text-faint);}
  .journal-card .mood{font-size:20px;line-height:1;}
  .journal-card .jc-date{font-size:12.5px;font-weight:600;text-transform:capitalize;}
  .journal-card .jc-preview{font-size:12px;color:var(--text-dim);margin-top:2px;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}

  .settings-pop{
    position:absolute;top:60px;right:22px;background:var(--surface);border:1px solid var(--border);
    border-radius:14px;padding:18px;width:270px;display:none;z-index:60;box-shadow:0 10px 30px rgba(0,0,0,.4);
  }
  .settings-pop.open{display:block;}
  .settings-pop h4{margin:0 0 12px;font-size:13px;}
  .toast{
    position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(20px);
    background:var(--surface-3);border:1px solid var(--border);color:var(--text);
    padding:10px 18px;border-radius:10px;font-size:12.5px;opacity:0;pointer-events:none;transition:.25s;z-index:200;
  }
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

  /* ---------- Finanzas ---------- */
  .brand,.tab-btn{white-space:nowrap;}
  .fin-head{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:8px;}
  .fin-head .month{display:flex;align-items:center;gap:6px;background:var(--surface);border:1px solid var(--border);border-radius:11px;padding:4px;}
  .fin-head .month button{background:transparent;border:none;color:var(--text);font-size:18px;width:32px;height:32px;border-radius:8px;cursor:pointer;}
  .fin-head .month button:hover{background:var(--surface-2);}
  .fin-head .month b{min-width:130px;text-align:center;font-size:14px;text-transform:capitalize;}
  .fin-head .sp{flex:1;}
  .fin-quick{display:grid;grid-template-columns:110px 1fr 120px 150px 140px auto;gap:8px;margin-top:14px;padding:12px;border:1px solid var(--border);border-radius:14px;background:linear-gradient(180deg,#171714,#131313);}
  .fin-quick input,.fin-quick select{background:var(--surface-2);border:1px solid var(--border);color:var(--text);border-radius:9px;padding:10px;font-size:14px;font-family:inherit;min-width:0;width:100%;}
  .fin-quick input:focus,.fin-quick select:focus{outline:none;border-color:var(--accent);}
  .fin-alerts{display:flex;flex-direction:column;gap:8px;margin-top:14px;}
  .fin-alert{border-radius:11px;padding:10px 14px;font-size:13px;border:1px solid;display:flex;gap:8px;align-items:center;}
  .fin-alert.warn{background:rgba(245,158,11,.10);border-color:rgba(245,158,11,.35);color:#f5c26b;}
  .fin-alert.bad{background:rgba(239,68,68,.10);border-color:rgba(239,68,68,.4);color:#f59a9a;}
  .fin-kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-top:14px;}
  .fin-kpis .kpi-card .value{font-size:20px;}
  .fin-sec{margin-top:22px;}
  .fin-sec-h{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px;}
  .fin-sec-h h3{margin:0;font-size:22px;}
  .fin-box{border:1px solid var(--border);border-radius:14px;background:var(--surface);padding:16px;}
  .fin-bar-row{margin-bottom:14px;}
  .fin-bar-row:last-child{margin-bottom:0;}
  .fin-bar-top{display:flex;justify-content:space-between;gap:10px;font-size:13px;margin-bottom:6px;flex-wrap:wrap;}
  .fin-bar-top .mono{font-size:12px;color:var(--text-dim);}
  .fin-bar{height:9px;border-radius:5px;background:var(--surface-3);overflow:hidden;position:relative;}
  .fin-bar i{display:block;height:100%;border-radius:5px;transition:width .3s;}
  .fin-two{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  .fin-week.cur .fin-bar-top b{color:var(--accent);}
  .fin-goals{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px;}
  .fin-goal{border:1px solid var(--border);border-radius:14px;background:var(--surface);padding:14px;}
  .fin-goal .nm{font-weight:600;display:flex;justify-content:space-between;gap:8px;margin-bottom:8px;}
  .fin-goal .meta{font-size:12px;color:var(--text-dim);margin-top:8px;line-height:1.5;}
  .fin-mini{background:transparent;border:1px solid var(--border);color:var(--text-dim);border-radius:7px;padding:3px 8px;font-size:12px;cursor:pointer;}
  .fin-mini:hover{color:var(--text);border-color:var(--text-faint);}
  .fin-tx-day{font-size:11.5px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.5px;margin:14px 0 6px;font-weight:600;}
  .fin-tx{display:flex;align-items:center;gap:10px;padding:9px 12px;border:1px solid var(--border);border-radius:10px;background:var(--surface);margin-bottom:6px;font-size:13.5px;}
  .fin-tx .d{flex:1;min-width:0;}
  .fin-tx .d small{display:block;color:var(--text-dim);font-size:11.5px;}
  .fin-tx .a{font-family:'JetBrains Mono',monospace;font-weight:700;white-space:nowrap;}
  .fin-tx .a.gasto{color:#ef4444;} .fin-tx .a.ingreso{color:#10b981;} .fin-tx .a.ahorro{color:var(--accent);} .fin-tx .a.inversion{color:#4d9de0;}
  .fin-tx .x{background:transparent;border:none;color:var(--text-faint);cursor:pointer;font-size:15px;padding:4px 6px;}
  .fin-tx .x:hover{color:#ef4444;}
  .fin-empty{color:var(--text-faint);font-size:13px;padding:14px 0;}
  .fin-filter{background:var(--surface);border:1px solid var(--border);color:var(--text);border-radius:8px;padding:6px 8px;font-size:12.5px;}
  @media(max-width:920px){
    .fin-quick{grid-template-columns:1fr 1fr;}
    .fin-quick #fqDesc{grid-column:1 / -1;}
    .fin-quick button{grid-column:1 / -1;}
    .fin-kpis{grid-template-columns:repeat(2,1fr);}
    .fin-two{grid-template-columns:1fr;}
  }

  /* ---------- Journal · bitácora AAR ---------- */
  .j-kpis .kpi-card .value{font-size:24px;}
  .j-kpis .kpi-card .sub{font-size:11.5px;color:var(--text-dim);margin-top:6px;line-height:1.4;}
  .aar-card{margin-top:16px;border-radius:14px;padding:20px;background:linear-gradient(180deg,#171714,#131313);border:1px solid var(--border);box-shadow:0 18px 40px -22px rgba(0,0,0,.7);}
  .aar-title{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:.03em;display:flex;gap:10px;align-items:baseline;flex-wrap:wrap;}
  .aar-title span{font-family:'IBM Plex Sans',sans-serif;font-size:11.5px;color:var(--text-faint);letter-spacing:0;}
  .aar-context{margin:12px 0 4px;padding:10px 14px;border-radius:10px;background:var(--surface-2);border:1px solid var(--border);font-size:13px;display:flex;gap:6px 14px;flex-wrap:wrap;align-items:center;}
  .aar-context b{color:var(--accent);} .aar-context .sep{color:var(--text-faint);}
  .aar-label{margin:18px 0 6px;font-size:11px;font-weight:600;letter-spacing:.6px;text-transform:uppercase;color:var(--text-dim);}
  .aar-q{font-size:13.5px;margin-bottom:8px;}
  .aar-card input[type=text]{width:100%;background:var(--surface-2);border:1px solid var(--border);color:var(--text);border-radius:8px;padding:10px 12px;font-size:13.5px;font-family:inherit;}
  .aar-card input[type=text]:focus,.aar-card textarea:focus{outline:none;border-color:var(--accent);}
  .jpills{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;}
  .jpill{background:transparent;border:1px solid var(--border);color:var(--text-dim);border-radius:10px;padding:10px 8px;cursor:pointer;font-family:inherit;font-size:13px;font-weight:600;text-align:center;transition:.18s;}
  .jpill small{display:block;font-weight:400;font-size:10.5px;color:var(--text-faint);margin-top:3px;line-height:1.3;}
  .jpill:hover{border-color:var(--text-faint);color:var(--text);}
  .jpill.sel{border-color:var(--accent);color:var(--text);background:var(--accent-soft);box-shadow:0 0 0 1px var(--accent),0 0 20px var(--accent-soft-2);}
  .jtags{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px;}
  .jtag{background:transparent;border:1px solid var(--border);color:var(--text-dim);border-radius:999px;padding:5px 12px;font-size:12px;cursor:pointer;font-family:inherit;transition:.15s;}
  .jtag:hover{color:var(--text);border-color:var(--text-faint);}
  .jtag.sel{border-color:var(--accent);color:var(--accent);background:var(--accent-soft);}
  .jfilters{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px;}
  .jfeed{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:12px;perspective:900px;}
  .jcard{background:linear-gradient(180deg,#171714,#131313);border:1px solid var(--border);border-radius:12px;padding:14px;cursor:pointer;transition:transform .2s,box-shadow .2s,border-color .2s;}
  .jcard:hover{transform:translateY(-4px) rotateX(2deg);border-color:rgba(255,255,255,.18);box-shadow:0 18px 30px -16px rgba(0,0,0,.8);}
  .jcard .top{display:flex;justify-content:space-between;align-items:center;gap:8px;}
  .jcard .jc-date{font-size:12.5px;font-weight:600;text-transform:capitalize;}
  .jcard .jc-st{font-size:11.5px;border:1px solid var(--border);border-radius:999px;padding:2px 9px;white-space:nowrap;}
  .jcard .jc-pct{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--text-dim);margin-top:8px;}
  .jcard .jc-rule{margin-top:8px;font-size:12.5px;line-height:1.45;color:var(--accent);}
  .jcard .jc-prev{margin-top:6px;font-size:12px;color:var(--text-dim);line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
  .rule-banner{margin:0 0 14px;padding:10px 14px;border-radius:11px;border:1px solid rgba(201,162,39,.4);background:var(--accent-soft);font-size:13px;display:none;align-items:center;gap:10px;}
  .rule-banner.show{display:flex;} .rule-banner b{color:var(--accent);} .rule-banner span{flex:1;}
  .rule-banner button{background:transparent;border:none;color:var(--text-dim);cursor:pointer;font-size:15px;}
  .jd-sec{margin-top:16px;} .jd-sec .k{font-size:11px;font-weight:600;letter-spacing:.6px;text-transform:uppercase;color:var(--text-dim);margin-bottom:5px;}
  .jd-sec .v{font-size:13.5px;line-height:1.55;white-space:pre-wrap;}
  .jauto{font-size:11.5px;color:var(--text-dim);margin-top:8px;line-height:1.5;display:flex;gap:8px;flex-wrap:wrap;align-items:center;}
  .jauto:empty{display:none;}
  .jmanual{font-size:10.5px;border:1px solid rgba(245,158,11,.5);color:#f5c26b;border-radius:999px;padding:1px 8px;}
  .jchip{background:transparent;border:1px dashed var(--border);color:var(--text-dim);border-radius:999px;padding:4px 11px;font-size:11.5px;cursor:pointer;font-family:inherit;}
  .jchip:hover{border-color:var(--accent);color:var(--accent);}
  .jdump{margin-top:18px;border:1px dashed var(--border);border-radius:10px;background:rgba(255,255,255,.015);}
  .jdump summary{cursor:pointer;padding:10px 14px;font-size:12.5px;color:var(--text-dim);list-style:none;display:flex;justify-content:space-between;gap:8px;}
  .jdump summary::-webkit-details-marker{display:none;}
  .jdump summary:hover{color:var(--text);} .jdump[open] summary{color:var(--accent);}
  .jdump summary i{font-style:normal;font-size:11px;color:var(--text-faint);}
  .jdump .jd-in{padding:0 14px 14px;}
  .jdump textarea{min-height:0;}
  .jcl{display:inline-flex;align-items:center;gap:4px;font-size:11px;border:1px solid rgba(201,162,39,.45);color:var(--accent);border-radius:999px;padding:1px 9px;}
  .jpat{margin-top:10px;padding:9px 12px;border-radius:9px;background:var(--accent-soft);border:1px solid rgba(201,162,39,.35);font-size:12.5px;line-height:1.5;}
  .jpat b{color:var(--accent);}
  .jpat.soft{background:transparent;border-style:dashed;color:var(--text-dim);}
  /* ---------- Finanzas v2 ---------- */
  .fin-quick{grid-template-columns:150px 1fr 120px 150px 150px 140px auto !important;}
  .fq-amt{display:flex;gap:4px;min-width:0;} .fq-amt input{flex:1;min-width:0;} .fq-amt select{width:58px !important;flex:none;padding:10px 4px !important;}
  .fq-pills{grid-column:1/-1;display:flex;gap:6px;flex-wrap:wrap;}
  .fq-pill{background:transparent;border:1px solid var(--border);color:var(--text-dim);border-radius:999px;padding:6px 12px;font-size:12.5px;cursor:pointer;font-family:inherit;transition:.15s;}
  .fq-pill:hover{border-color:var(--accent);color:var(--accent);background:var(--accent-soft);}
  .fq-pill.fx{border-style:dashed;margin-left:auto;}
  .fq-fx{grid-column:1/-1;font-size:12.5px;color:var(--text-dim);display:flex;align-items:center;gap:6px;flex-wrap:wrap;}
  .fq-fx input{width:90px !important;padding:6px 8px !important;} .fq-fx span{color:var(--accent);font-weight:600;}
  .fin-kpis{grid-template-columns:repeat(4,1fr) !important;}
  .fin-kpis .kpi-card .value{font-size:22px;color:var(--text) !important;} .fin-kpis .kpi-card .value.dim{color:var(--text-faint) !important;}
  .fin-kpis .kpi-card .value small{font-size:12px;color:var(--text-dim);font-weight:400;}
  .fin-kpis .kpi-card .sub{font-size:11.5px;color:var(--text-dim);margin-top:6px;line-height:1.45;}
  .fin-kpis .kpi-card .sub b{font-weight:600;} .fin-kpis .kpi-card .sub .gd,.fin-note .gd{color:#34d399;} .fin-kpis .kpi-card .sub .bd,.fin-note .bd{color:#f87171;}
  .fin-two{margin-top:14px;align-items:stretch;}
  .fin-card{border:1px solid rgba(255,255,255,.08);border-radius:14px;background:linear-gradient(180deg,#171714,#131313);padding:16px;transition:transform .2s,border-color .2s,box-shadow .2s;min-width:0;}
  .fin-card:hover{transform:translateY(-4px);border-color:rgba(255,255,255,.18);box-shadow:0 18px 30px -18px rgba(0,0,0,.8);}
  .radar{background:linear-gradient(160deg,#14161f,#0d0e13);border:1px solid rgba(234,179,8,.22);border-radius:18px;padding:18px 20px;margin-bottom:16px;box-shadow:0 18px 40px rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.05);}
