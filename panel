  /* ---------------- Día fuga ---------------- */
  function computeWeekdayStats(){
    const sums=[0,0,0,0,0,0,0], counts=[0,0,0,0,0,0,0];
    const perHabit = [{},{},{},{},{},{},{}];
    const today = startOfToday();
    for(let i=1;i<=56;i++){
      const d = new Date(today); d.setDate(d.getDate()-i);
      const key = todayKey(d);
      if(isDayDisabled(key)) continue;
      const active = state.habits.filter(h=>getHabitStart(h)<=d && !isRest(h,key));
      if(!active.length) continue;
      const wd = d.getDay();
      const done = active.filter(h=>h.logs[key]).length;
      sums[wd] += done/active.length; counts[wd]++;
      active.forEach(h=>{
        if(!perHabit[wd][h.id]) perHabit[wd][h.id] = {h, done:0, total:0};
        perHabit[wd][h.id].total++;
        if(h.logs[key]) perHabit[wd][h.id].done++;
      });
    }
    const rates = sums.map((v,i)=> counts[i] ? Math.round(v/counts[i]*100) : null);
    const totalCount = counts.reduce((a,b)=>a+b,0);
    const overall = totalCount ? Math.round(sums.reduce((a,b)=>a+b,0)/totalCount*100) : null;
    return { rates, counts, overall, perHabit };
  }
  function getLeakInfo(){
    const st = computeWeekdayStats();
    if(st.overall===null) return null;
    const order = [1,2,3,4,5,6,0];
    const leak = order.filter(i=> st.rates[i]!==null && st.counts[i]>=2 && st.rates[i] <= st.overall-10);
    let worst = -1;
    order.forEach(i=>{ if(st.rates[i]!==null && st.counts[i]>=2 && (worst===-1 || st.rates[i]<st.rates[worst])) worst = i; });
    return { st, order, leak, worst };
  }

  function leakTip(st,i){
    const cap = DAY_NAMES[i].charAt(0).toUpperCase()+DAY_NAMES[i].slice(1);
    const w = Object.values(st.perHabit[i]).filter(x=>x.total>=2).map(x=>({h:x.h,r:Math.round(x.done/x.total*100)})).sort((a,b)=>a.r-b.r)[0];
    return (`${cap}: ${st.rates[i]}% cumplimiento\n`+(w?`Hábito más afectado: ${w.h.name.split("(")[0].trim()} (${w.r}%)`:"")).replace(/"/g,"&quot;");
  }
  function renderDayLeak(){
    const sec = document.getElementById("leakSection"), box = document.getElementById("leakBox");
    const info = state.habits.length ? getLeakInfo() : null;
    if(!info){ sec.style.display="none"; box.style.display="none"; return; }
    sec.style.display = "flex"; box.style.display = "block";
    const {st, order, leak, worst} = info;
    const letters = {1:"L",2:"M",3:"X",4:"J",5:"V",6:"S",0:"D"};
    document.getElementById("leakPlot").innerHTML =
      (st.overall!==null ? `<div class="leak-avg" style="bottom:${st.overall*1.3}px;"><span>promedio ${st.overall}%</span></div>` : "") +
      order.map(i=>{
        const r = st.rates[i];
        if(r===null) return `<div class="leak-col"><div class="leak-val" style="color:var(--text-faint);">—</div><div class="leak-bar" style="height:4px;background:var(--surface-3);"></div></div>`;
        return `<div class="leak-col" data-tip="${leakTip(st,i)}">
          <div class="leak-val">${r}%</div>
          <div class="leak-bar ${leak.includes(i)?"leak":""}" style="height:${Math.max(4,r*1.3)}px;background:${leak.includes(i)?progressColor(r):COL.neutral};"></div>
        </div>`;
      }).join("");
    document.getElementById("leakLabels").innerHTML = order.map(i=>`<div class="${leak.includes(i)?"leak":""}" title="${DAY_NAMES[i]}">${letters[i]}</div>`).join("");

    const alertEl = document.getElementById("leakAlert");
    if(leak.length===0){
      alertEl.className = "leak-alert good";
      alertEl.innerHTML = `<b>Sin fuga sistemática.</b> Tu cumplimiento es estable entre días (ningún día cae 10 puntos o más bajo tu promedio de ${st.overall}%).`;
      return;
    }
    const weekend = [5,6,0];
    const onlyWeekend = leak.every(i=>weekend.includes(i));
    let headline;
    if(onlyWeekend && (leak.includes(6)||leak.includes(0))) headline = "Fuga operativa detectada en fines de semana";
    else if(leak.length===1 && leak[0]===5) headline = "Fuga operativa detectada los viernes";
    else headline = "Fuga operativa detectada: " + leak.map(i=>DAY_NAMES[i]).join(", ");
    let detail = `<b>${DAY_NAMES[worst]}</b> rinde ${st.rates[worst]}% frente a tu promedio de ${st.overall}% (${st.overall-st.rates[worst]} puntos por debajo).`;
    const hs = Object.values(st.perHabit[worst]).filter(x=>x.total>=2).map(x=>({h:x.h, r:Math.round(x.done/x.total*100)})).sort((a,b)=>a.r-b.r)[0];
    if(hs) detail += ` Hábito más afectado ese día: <b>${hs.h.icon} ${hs.h.name.split("(")[0].trim()}</b> (${hs.r}%).`;
    alertEl.className = "leak-alert bad";
    alertEl.innerHTML = `<b>⚠ ${headline}.</b><br>${detail}`;
  }

  /* ---------------- Diagnóstico semanal ---------------- */
  function diagWeekKey(){ return getWeekKey(new Date()); }
  function getDiag(){
    const k = diagWeekKey();
    if(!state.diagnostics[k]) state.diagnostics[k] = {bottleneck:"", action:"", target:""};
    return state.diagnostics[k];
  }
  function diagSuggestions(){
    const rows = state.habits.map(h=>({h, r:rateLastDays(h,7)})).filter(x=>x.r!==null).sort((a,b)=>a.r-b.r);
    const worst = rows[0] || null;
    const info = getLeakInfo();
    const m = computeMoM();
    const r7 = overallLastDays(7), r30 = overallLastDays(30);
    let target = null, why = "";
    if(m.rc!==null && m.rp!==null && m.rc<m.rp){ target = m.rp; why = `igualar ${shortMonth(m.prev)} (${m.rp}%) y salir de la tendencia roja`; }
    else if(r30!==null){ target = Math.min(100, r30+5); why = `subir 5 puntos sobre tu promedio de 30 días (${r30}%)`; }
    return {worst, info, r7, r30, target, why};
  }
  function renderDiagnosis(){
    const sec = document.getElementById("diagSection"), box = document.getElementById("diagBox");
    if(state.habits.length===0){ sec.style.display="none"; box.style.display="none"; return; }
    sec.style.display = "flex"; box.style.display = "block";
    document.getElementById("diagWeekLabel").textContent = periodLabel("week", new Date());
    const d = getDiag();
    const sg = diagSuggestions();
    const bt = document.getElementById("diagBottleneck"), ac = document.getElementById("diagAction"), tg = document.getElementById("diagTarget");
    if(document.activeElement!==bt) bt.value = d.bottleneck;
    if(document.activeElement!==ac) ac.value = d.action;
    if(document.activeElement!==tg) tg.value = d.target;

    const s1 = document.getElementById("diagSuggest1");
    s1.textContent = sg.worst
      ? `Sugerencia automática: «${sg.worst.h.icon} ${sg.worst.h.name.split("(")[0].trim()}» fue tu punto más bajo (${sg.worst.r}% en los últimos 7 días).`
      : "Aún no hay suficientes datos de los últimos 7 días.";
    document.getElementById("diagUse1").style.display = sg.worst ? "" : "none";

    const s2 = document.getElementById("diagSuggest2");
    if(sg.info && sg.info.leak.length){
      s2.textContent = `Patrón detectado: fuga los ${sg.info.leak.map(i=>DAY_NAMES[i]).join(", ")}. Considera mover el hábito a otra ventana horaria o prepararlo la noche anterior.`;
    } else {
      s2.textContent = "Define un ajuste concreto: horario, entorno o disparador del hábito que falló.";
    }

    const s3 = document.getElementById("diagSuggest3");
    document.getElementById("diagUse3").style.display = sg.target!==null ? "" : "none";
    s3.textContent = sg.target!==null
      ? `Meta sugerida: ${sg.target}% (${sg.why}). Últimos 7 días: ${sg.r7===null?"—":sg.r7+"%"}.`
      : "Aún no hay suficientes datos para sugerir una meta.";
    const tv = parseInt(d.target);
    document.getElementById("diagGap").textContent = (!isNaN(tv) && sg.r7!==null)
      ? (tv>sg.r7 ? `Brecha: +${tv-sg.r7} puntos sobre tu ritmo actual` : "Meta alcanzada con tu ritmo actual")
      : "";
  }
  [["diagBottleneck","bottleneck"],["diagAction","action"],["diagTarget","target"]].forEach(([id,field])=>{
    document.getElementById(id).addEventListener("input", (e)=>{
      const d = getDiag(); d[field] = e.target.value; save();
      if(field==="target") renderDiagnosis();
    });
  });
  document.getElementById("diagUse1").addEventListener("click", ()=>{
    const sg = diagSuggestions(); if(!sg.worst) return;
    const d = getDiag(); d.bottleneck = `${sg.worst.h.name.split("(")[0].trim()} cayó a ${sg.worst.r}% esta semana.`; save(); renderDiagnosis();
  });
  document.getElementById("diagUse3").addEventListener("click", ()=>{
    const sg = diagSuggestions(); if(sg.target===null) return;
    const d = getDiag(); d.target = String(sg.target); save(); renderDiagnosis();
  });

