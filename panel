  /* ---- clústeres de palabras clave (análisis local, sin APIs) ---- */
  function jClusters(){ return [
    {id:"rel",  tag:"#Relación", label:"Relación / Pareja",   icon:"💬", w:["pele","discusi","discut","pareja","molest","tension","distanci","reclam","novia","novio","esposa","esposo"], ph:[]},
