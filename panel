          : `<div class="fin-empty">Aún no hay gastos este mes.</div>`}</div>
      </div>
      ${catCards?`<div class="fin-sec" style="margin-top:14px;"><div class="fin-sec-h"><h3>Categorías de gasto</h3><span style="font-size:11px;color:var(--text-faint)">Clic en una card para filtrar los movimientos · ✎ para fijar su tope</span></div><div class="fin-cats">${catCards}</div>${inactiveHtml}</div>`:""}
      <div class="fin-two">
        <div class="fin-card"><div class="fin-card-h"><b>Gastos fijos del mes</b><span><button class="fin-mini" data-act="fixed-edit">✎ Plantilla</button>${pendFixed>0?` <button class="fin-mini gold" data-act="fixed-all">Pagar todos</button>`:""}</span></div>${fixedHtml}</div>
        <div class="fin-card"><div class="fin-card-h"><b>Cruce con tu bitácora</b><span>gastos variables × estado del día</span></div>${finJournalCross()}</div>
      </div>
      <div class="fin-card" style="margin-top:14px;"><div class="fin-card-h"><b>Patrimonio · ahorro logrado vs. activo</b><span>todo tu historial</span></div>${savHtml}</div>
      <div class="fin-two">
        <div class="fin-card"><div class="fin-card-h"><b>Metas de ahorro</b><span><button class="fin-mini" data-act="goal-new">+ Nueva meta</button></span></div>${goalsHtml}</div>
        <div class="fin-card"><div class="fin-card-h"><b>Inversiones</b><span><button class="fin-mini" data-act="inv-new">+ Nueva inversión</button></span></div>${invHtml}</div>
      </div>
      <div class="fin-sec" id="finMovs"><div class="fin-sec-h"><h3>Movimientos${finCatFilter!=="todas"?` · ${escHtml(finCatFilter)}`:""}</h3><span class="fin-filters">
        <input type="search" class="fin-filter" id="finSearch" placeholder="🔎 Buscar…" value="${escAttr(finSearch)}" style="min-width:130px;"><select class="fin-filter" id="finFilterSel"><option value="todos">Todos los tipos</option>${Object.keys(FIN_TYPES).map(k=>`<option value="${k}" ${finFilter===k?"selected":""}>${FIN_TYPES[k]}</option>`).join("")}</select>
        <select class="fin-filter" id="finCatSel"><option value="todas">Todas las categorías</option>${catOpts.map(k=>`<option value="${escAttr(k)}" ${finCatFilter===k?"selected":""}>${escHtml(k)}</option>`).join("")}</select></span></div>
        <div id="finFeed">${finFeedHtml()}</div></div>`;
  }
  function finTxEdit(id){
    const t = fin.tx.find(x=>x.id===id); if(!t) return;
    const catSel = `<select id="feCat">${fin.cfg.cats.map(k=>`<option ${k===t.cat?"selected":""}>${escHtml(k)}</option>`).join("")}</select>`;
    finModal("Editar movimiento", `<div class="field-row"><div class="field"><label>Monto (S/)</label><input type="number" step="0.01" min="0" id="feAmt" value="${t.amount}"></div><div class="field"><label>Fecha</label><input type="date" id="feDate" value="${t.date}"></div></div>
      <div class="field"><label>Descripción</label><input type="text" id="feDesc" value="${escAttr(t.desc||"")}"></div>
      ${t.space==="hogar"?`<div class="field"><label>¿Quién pagó / aportó?</label><input type="text" id="fePayer" value="${escAttr(t.payer||"")}"></div>`:""}
      ${t.type==="gasto" && t.space!=="hogar"?`<div class="field-row"><div class="field"><label>Categoría</label>${catSel}</div><div class="field"><label>Origen</label><select id="feFund"><option value="sueldo" ${t.fund!=="ahorro"?"selected":""}>💳 Sueldo base</option><option value="ahorro" ${t.fund==="ahorro"?"selected":""}>🏦 Fondo de ahorro</option></select></div></div>`:""}`,
      ov=>{
        const a = finNum(ov.querySelector("#feAmt").value); if(!(a>0)){ toast("Monto inválido"); return false; }
        t.amount = Math.round(a*100)/100; t.date = ov.querySelector("#feDate").value || t.date; t.desc = ov.querySelector("#feDesc").value.trim();
        if(t.space==="hogar"){ t.payer = ov.querySelector("#fePayer").value.trim() || t.payer; }
        if(t.type==="gasto" && t.space!=="hogar"){ t.cat = ov.querySelector("#feCat").value; if(ov.querySelector("#feFund").value==="ahorro") t.fund="ahorro"; else delete t.fund; }
        finSaveLocal(); finPushTx(t); hcPush(t); renderFin(); toast("Movimiento actualizado");
      });
  }
  function finFeedHtml(){
    let list = fin.tx.filter(t=>t.space!=="hogar" && t.date && t.date.slice(0,7)===finMonth).sort((a,b)=> b.date.localeCompare(a.date) || (b.createdAt||0)-(a.createdAt||0));
    if(finFilter!=="todos") list = list.filter(t=>t.type===finFilter);
    if(finCatFilter!=="todas") list = list.filter(t=>t.cat===finCatFilter);
    const q = normName(finSearch).trim();
    if(q) list = list.filter(t=>normName([t.desc,t.cat,t.sub].join(" ")).indexOf(q)>=0);
    if(!list.length) return `<div class="fin-empty">Sin movimientos en este mes para estos filtros.</div>`;
    const days = {}; list.forEach(t=>{ (days[t.date] = days[t.date]||[]).push(t); });
    const MES = ["ene","feb","mar","abr","may","jun","jul","ago","sep","oct","nov","dic"];
    return Object.keys(days).sort().reverse().map(d=>{
      const cons = days[d].filter(t=>t.type==="gasto" && finIsSalary(t)).reduce((a,t)=>a+t.amount,0);
      const rows = days[d].map(t=>{
        const goal = t.goalId ? (fin.goals.find(g=>g.id===t.goalId)||{}).name : t.investId ? (fin.invest.find(g=>g.id===t.investId)||{}).name : "";
        const usd = t.orig && t.orig.cur==="USD" ? ` <span class="usd">US$ ${t.orig.amt}</span>` : "";
        const tag = t.src==="form" ? " · 📲" : t.src==="fijo" ? " · fijo" : "";
        const act = `<span class="acts"><button class="x" data-act="tx-edit" data-id="${t.id}" title="Editar">✎</button><button class="x" data-act="tx-del" data-id="${t.id}" title="Eliminar">✕</button></span>`;
        if(t.type==="hogar"){
          return `<div class="fin-row xfer"><div class="ds"><b>${escHtml(t.desc||"Aporte casa")}</b><small>Transferencia a Fondo Hogar${tag}</small></div><div class="am gold">↗ ${finMoney(t.amount)} <small>→ Hogar</small></div>${act}</div>`;
        }
        if(t.type==="ahorro" || t.type==="inversion"){
          return `<div class="fin-row xfer"><div class="ds"><b>${escHtml(t.desc||FIN_TYPES[t.type])}</b><small>${t.type==="ahorro"?"Transferencia a ahorro":"Aporte a inversión"}${goal?" · "+escHtml(goal):""}${tag}</small></div><div class="am gold">↗ ${finMoney(t.amount)} <small>→ ${t.type==="ahorro"?"Capital":"Inversión"}</small>${usd}</div>${act}</div>`;
        }
        const isInc = t.type==="ingreso", fromSav = t.fund==="ahorro";
        return `<div class="fin-row"><div class="ds"><b>${escHtml(t.desc || t.cat || FIN_TYPES[t.type])}</b><small>${isInc?"Ingreso":escHtml(t.cat||"")}${isInc?"":` <span class="orig ${fromSav?"sav":""}">${fromSav?"Ahorro":"Sueldo"}</span>`}${tag}</small></div><div class="am ${isInc?"inc":""}">${isInc?"+":"−"}${finMoney(t.amount)}${usd}</div>${act}</div>`;
      }).join("");
      return `<div class="fin-day"><div class="dh"><span>${parseInt(d.slice(8,10))} ${MES[parseInt(d.slice(5,7))-1]}</span>${cons>0?`<span>Consumo del día: <b>${finMoney(cons)}</b></span>`:""}</div>${rows}</div>`;
    }).join("");
  }
  document.getElementById("hogarFile").addEventListener("change", e=>{ const f = e.target.files[0]; e.target.value = ""; if(f) hogarImport(f); });
  document.getElementById("view-finanzas").addEventListener("submit", e=>{
    if(e.target.id!=="hogarForm") return; e.preventDefault();
    const a = parseFloat(document.getElementById("hgAmt").value); if(!(a>0)){ toast("Escribe un monto mayor a 0"); return; }
    const kind = document.getElementById("hgKind").value, payer = document.getElementById("hgPayer").value.trim() || (fin.cfg.hogarName||"Yo");
    const t = {id:"h"+Date.now().toString(36)+uid(), date:document.getElementById("hgDate").value || todayKey(), amount:Math.round(a*100)/100, type:kind, cat:kind==="gasto"?document.getElementById("hgCat").value:"Fondo", desc:document.getElementById("hgDesc").value.trim(), payer, space:"hogar", src:"panel", createdAt:Date.now(), pending:true};
    fin.tx.push(t); finSaveLocal(); finPushTx(t); hcPush(t); if(t.date.slice(0,7)!==finMonth) finMonth = t.date.slice(0,7); renderFin(); toast("Hogar: "+(kind==="gasto"?"gasto":"aporte")+" "+finMoney(t.amount)+" · "+payer);
  });
  document.getElementById("view-finanzas").addEventListener("input", e=>{
    if(e.target.id==="finSearch"){ finSearch = e.target.value; const f = document.getElementById("finFeed"); if(f) f.innerHTML = finFeedHtml(); }
  });
  function finPayAllFixed(){
    const pend = (fin.cfg.fixed||[]).filter(f=>!finFixedPaid(f, finMonth));
    if(!pend.length){ toast("No hay gastos fijos pendientes"); return; }
    if(!confirm("¿Registrar como pagados "+pend.length+" gastos fijos por "+finMoney(pend.reduce((a,f)=>a+(Number(f.amount)||0),0))+"?")) return;
    pend.forEach(finConfirmFixed); finSaveLocal(); renderFin(); toast("Gastos fijos del mes registrados");
  }
  document.getElementById("view-finanzas").addEventListener("change", e=>{
    if(e.target.id==="finCatSel"){ finCatFilter = e.target.value; renderFin(); return; }
    if(e.target.id==="finFilterSel"){ finFilter = e.target.value; renderFin(); }
  });
  document.getElementById("view-finanzas").addEventListener("click", e=>{
    const b = e.target.closest("[data-act]"); if(!b) return;
    const act = b.dataset.act, id = b.dataset.id;
    if(act==="budget") finBudgetModal();
    else if(act==="space-p" || act==="space-h"){ finSpace = act==="space-h" ? "hogar" : "personal"; try{ localStorage.setItem("panel_fin_space", finSpace); }catch(e){} renderFin(); }
    else if(act==="toggle-inactive"){ finShowInactive = !finShowInactive; renderFin(); }
    else if(act==="hc-open"){ e.preventDefault(); hcModal(); }
    else if(act==="hogar-export") hogarExport();
    else if(act==="hogar-import") document.getElementById("hogarFile").click();
    else if(act==="hogar-name"){ e.preventDefault(); const n = (prompt("Tu nombre en los paquetes del hogar:", fin.cfg.hogarName||"")||"").trim(); if(n){ fin.cfg.hogarName = n; finCfgChanged(); renderFin(); } }
    else if(act==="mode-total"){ finChartMode = "total"; renderFin(); }
    else if(act==="mode-var"){ finChartMode = "variable"; renderFin(); }
    else if(act==="cat-pick"){ const k = b.dataset.k; finCatFilter = finCatFilter===k ? "todas" : k; renderFin(); const m = document.getElementById("finMovs"); if(m && finCatFilter!=="todas") m.scrollIntoView({behavior:"smooth", block:"start"}); }
    else if(act==="cat-cap"){ const k = b.dataset.k; e.stopPropagation();
      finModal("Tope mensual · "+escHtml(k), `<div class="field"><label>Límite para ${escHtml(k)} (S/ al mes, vacío = sin tope)</label><input type="number" min="0" step="1" id="fcCap" value="${fin.cfg.catBudgets[k]||""}"></div>`,
        ov=>{ const v = finNum(ov.querySelector("#fcCap").value); if(v) fin.cfg.catBudgets[k] = v; else delete fin.cfg.catBudgets[k]; finCfgChanged(); renderFin(); }); }
    else if(act==="adj-exec"){
      finModal("Ajustar saldo ejecutado", `<div style="font-size:12px;color:var(--text-dim);margin-bottom:10px;">Monto de ahorro que ya usaste (compras grandes, metas cumplidas). Baja tu <b>Ahorro activo</b> pero tu <b>Ahorro histórico logrado</b> se mantiene intacto.</div>
        <div class="field"><label>Total ejecutado a descontar (S/)</label><input type="number" min="0" step="0.01" id="faAdj" value="${fin.cfg.execAdj||""}"></div>`,
        ov=>{ fin.cfg.execAdj = finNum(ov.querySelector("#faAdj").value)||0; finCfgChanged(); renderFin(); toast("Saldo ejecutado actualizado"); });
    }
    else if(act==="tx-edit"){ finTxEdit(id); }
    else if(act==="goal-exec"){ const g = fin.goals.find(x=>x.id===id); if(g){ g.executed = !g.executed; finCfgChanged(); renderFin(); toast(g.executed?"Meta marcada como ejecutada: su ahorro sigue en tu histórico":"Meta reactivada"); } }
    else if(act==="fixed-edit") finFixedModal();
    else if(act==="fixed-pay"){ const f = (fin.cfg.fixed||[]).find(x=>x.id===id); if(f && !finFixedPaid(f, finMonth)){ finConfirmFixed(f); finSaveLocal(); renderFin(); toast("Pagado: "+f.name+" "+finMoney(f.amount)); } }
    else if(act==="fixed-all") finPayAllFixed();
    else if(act==="goal-new") finGoalModal();
    else if(act==="goal-edit"){
      finGoalModal(id);
      // botón eliminar dentro del modal de edición
      const ov = document.querySelector(".modal-overlay.open:last-of-type .modal");
      if(ov){ const del = document.createElement("button"); del.className="btn danger small"; del.textContent="Eliminar meta"; del.style.marginTop="10px";
        del.onclick = ()=>{ if(confirm("¿Eliminar esta meta? Los aportes registrados se conservan como ahorro general.")){ fin.goals = fin.goals.filter(g=>g.id!==id); fin.tx.forEach(t=>{ if(t.goalId===id) delete t.goalId; }); finCfgChanged(); finQuickType(); renderFin(); ov.parentElement.remove(); } };
        ov.appendChild(del); }
    }
    else if(act==="inv-new") finInvModal();
    else if(act==="inv-edit"){
      finInvModal(id);
      const ov = document.querySelector(".modal-overlay.open:last-of-type .modal");
      if(ov){ const del = document.createElement("button"); del.className="btn danger small"; del.textContent="Eliminar inversión"; del.style.marginTop="10px";
        del.onclick = ()=>{ if(confirm("¿Eliminar esta inversión?")){ fin.invest = fin.invest.filter(g=>g.id!==id); fin.tx.forEach(t=>{ if(t.investId===id) delete t.investId; }); finCfgChanged(); finQuickType(); renderFin(); ov.parentElement.remove(); } };
        ov.appendChild(del); }
    }
    else if(act==="goal-add" || act==="inv-add"){
      document.getElementById("fqType").value = act==="goal-add" ? "ahorro" : "inversion"; finQuickType();
      document.getElementById("fqTarget").value = id;
      window.scrollTo({top:0,behavior:"smooth"}); document.getElementById("fqAmount").focus();
    }
    else if(act==="tx-del"){
      if(!confirm("¿Eliminar este movimiento?")) return;
      const gone = fin.tx.find(t=>t.id===id); if(gone && gone.space==="hogar") hcRemove(id);
      fin.tx = fin.tx.filter(t=>t.id!==id); finSaveLocal();
      if(cloud.user && cloud.db) cloud.db.doc(`users/${cloud.user.uid}/fin_tx/${id}`).delete().catch(e=>console.error(e));
      renderFin();
    }
  });
  finLoad();
  document.getElementById("fqDate").value = todayKey();
  finFillQuick(); finPillsUi(); document.getElementById("fqFx").value = fin.cfg.fx || 3.75;

  applyAccent();
  applyBackground();
  buildSettingsUI();
  renderAll();
  setupPWA();
  initCloud();

})();
</script>
<div class="made-by">Creado por: Coaching TDHA</div>
</body>
</html>
