  function journalOnShow(){ if(jDirty){ renderJournalKpis(); renderJournalContext(); } else renderJournalView(); }
  /* ---- Radar de Evolución 90D · evidencia vs. percepción ---- */
  const RD_FRIC = ["frustr","quej","lament","saturad","cansad","trabajo","estres","agobi","harto","presion","agotad","abrum"];
  const RD_CTRL = ["aprend","solucion","control","avanc","gratitud","agradec","logr","decid","enfoc","orden","plan"];
  function renderRadar(){
    const box = document.getElementById("jRadar"); if(!box) return;
    const t0 = startOfToday(), dAdd = (d,n)=>{ const x = new Date(d); x.setDate(x.getDate()+n); return x; };
    const cF = dAdd(t0,-29), bT = dAdd(t0,-90), bF = dAdd(t0,-119);
    const kcF = todayKey(cF), kcT = todayKey(t0), kbF = todayKey(bF), kbT = todayKey(bT);
    const inW = (k,a,b)=>k>=a && k<=b;
    // Mentalidad
    const wordCount = (a,b)=>{ let fr=0, ct=0, n=0;
      Object.keys(state.journal||{}).forEach(k=>{ if(!inW(k,a,b)) return; const e = state.journal[k]; const txt = normName([e.dump,e.leak,e.win,e.rule].filter(Boolean).join(" ")); if(!txt.trim()) return; n++;
        txt.split(/[^a-z0-9ñ]+/).filter(Boolean).forEach(t=>{ if(RD_FRIC.some(w=>t.indexOf(w)===0)) fr++; if(RD_CTRL.some(w=>t.indexOf(w)===0)) ct++; }); });
      return {fr, ct, n, tot:fr+ct}; };
    const mB = wordCount(kbF,kbT), mC = wordCount(kcF,kcT);
    const ment = (mB.tot>=3 && mC.tot>=3) ? {bFr:Math.round(mB.fr/mB.tot*100), cFr:Math.round(mC.fr/mC.tot*100), cCt:Math.round(mC.ct/mC.tot*100)} : null;
    // Hábitos
    const rate = (h,a,b)=>{ let num=0, den=0; for(let d=new Date(a); d<=b; d.setDate(d.getDate()+1)){ const k = todayKey(d); if(h.createdAt && k<h.createdAt) continue; if(isOffFor(h,k)) continue; den++; if(h.logs[k]) num++; } return den>=7 ? num/den*100 : null; };
    const avgRate = (hs,a,b)=>{ const r = hs.map(h=>rate(h,a,b)).filter(x=>x!==null); return r.length ? r.reduce((x,y)=>x+y,0)/r.length : null; };
    const hAbs = state.habits.filter(h=>/abstin/i.test(h.name));
    let pil = state.habits.filter(h=>h.pillar); if(!pil.length) pil = state.habits.filter(h=>/estudi|descans|ejercic/i.test(h.name));
    const abB = avgRate(hAbs,bF,bT), abC = avgRate(hAbs,cF,t0), piB = avgRate(pil,bF,bT), piC = avgRate(pil,cF,t0);
    // Agenda
    const rocks = (a,b)=>{ let done=0, tot=0; Object.keys(state.bigRocks||{}).forEach(k=>{ if(!inW(k,a,b)) return; (state.bigRocks[k]||[]).filter(r=>String(r.text||"").trim()).forEach(r=>{ tot++; if(r.done) done++; }); }); return {done, tot}; };
    const rB = rocks(kbF,kbT), rC = rocks(kcF,kcT);
    const rkB = rB.tot>=3 ? rB.done/30 : null, rkC = rC.tot>=3 ? rC.done/30 : null;
    // Finanzas
    let cap = null;
    try{
      const capTo = k => fin.tx.filter(t=>(t.type==="ahorro"||t.type==="inversion") && t.date<=k).reduce((a,t)=>a+t.amount,0);
      const vr = (a,b) => fin.tx.filter(t=>t.type==="gasto" && t.space!=="hogar" && finIsSalary(t) && !finIsFixedTx(t) && inW(t.date,a,b)).reduce((x,t)=>x+t.amount,0);
      const hB = capTo(kbT), hC = capTo(kcT), vB = vr(kbF,kbT), vC = vr(kcF,kcT);
      if(hC>0 || vB>0 || vC>0) cap = {hB, hC, vB, vC};
    }catch(e){}
    const pct = x => Math.round(x)+"%", mon = n => "S/ "+Math.round(n).toLocaleString("es-PE");
    const pills = [], verdicts = [], parts = [];
    if(ment){
      const good = ment.cCt>ment.bFr || ment.cFr<ment.bFr;
      pills.push({l:"Mentalidad", a:"Queja "+ment.bFr+"%", b:"Control "+ment.cCt+"%", good, n:"Bitácora · palabras clave"}); verdicts.push(good);
      parts.push(`Hace 3 meses el <b>${ment.bFr}%</b> de tus palabras en la Bitácora hablaban de fricción (queja, cansancio, trabajo). Hoy esa fricción es del <b>${ment.cFr}%</b> y el <b>${ment.cCt}%</b> de tus notas habla de control, avance y aprendizaje.`);
    } else pills.push({l:"Mentalidad", a:"—", b:"—", good:null, n:"Escribe más en Bitácora (≥3 palabras clave por periodo)"});
    if(abB!==null && abC!==null){
      const dlt = abC-abB, good = dlt>=1 ? true : dlt<=-1 ? false : null; pills.push({l:"Abstinencia", a:pct(abB), b:pct(abC), good, n:good===null?"estable":(dlt>=0?"+":"")+Math.round(dlt)+" pts"}); if(good!==null) verdicts.push(good);
      if(piB!==null && piC!==null && Math.abs(piC-piB)>=1) verdicts.push(piC>piB);
      parts.push(`En <b>Abstinencia</b> pasaste de ${pct(abB)} a <b>${pct(abC)}</b>${piB!==null&&piC!==null?`, y tus hábitos pilar de ${pct(piB)} a <b>${pct(piC)}</b>`:""}.`);
    } else if(piB!==null && piC!==null){
      const good = piC>=piB; pills.push({l:"Hábitos pilar", a:pct(piB), b:pct(piC), good, n:(piC-piB>=0?"+":"")+Math.round(piC-piB)+" pts"}); verdicts.push(good);
