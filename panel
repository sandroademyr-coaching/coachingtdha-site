  const STATUS_META = {
    no_iniciado:{label:"No iniciado", color:"#8f8f8f"},
    en_progreso:{label:"En progreso", color:"#4d9de0"},
    en_pausa:{label:"En pausa", color:"#e8a33d"},
    completado:{label:"Completado", color:"#3ddc84"}
  };
  const PRIORITY_META = {
    alta:{label:"Alta", color:"var(--accent)"},
    media:{label:"Media", color:"#e8a33d"},
    baja:{label:"Baja", color:"#8f8f8f"}
  };

  const PERIOD_TITLES = { week:"Objetivos de la semana", month:"Objetivos del mes", quarter:"Objetivos del trimestre", year:"Objetivos del año" };

  function renderObjectivesPeriod(){
    const period = currentPeriod;
