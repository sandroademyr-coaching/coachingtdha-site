  /* ---- autodiagnóstico: el estado y las fugas salen de tus datos del día ---- */
  function jSuggest(key){
    if(key > todayKey(new Date())) return null;                       // días futuros: sin sugerencia
    const p = computeDayProductivity(key);
    if(!p.habitsTotal) return null;                                   // día libre o sin hábitos
    const pct = Math.round(p.habitsDone/p.habitsTotal*100);
    const hab = re => state.habits.find(h=>re.test(normName(h.name)));
    const est = hab(/estudi/), abs = hab(/abstin/), mov = hab(/movil|celular|pantalla/);
    const pillars = state.habits.filter(h=>h.pillar), pDone = pillars.filter(h=>h.logs[key]||isRest(h,key)).length;
    const pAll = pillars.length>0 && pDone===pillars.length;
    const p23 = pillars.length===0 || pDone/pillars.length >= 2/3 - 1e-9;
    const rocks = (state.bigRocks[key]||[]).filter(r=>String(r.text||"").trim()), rDone = rocks.filter(r=>r.done).length;
    // estado
    let status;
    if(pct<50 || (est && abs && !est.logs[key] && !abs.logs[key] && !isRest(est,key) && !isRest(abs,key))) status = "fuga";
    else if(pct<60) status = "disperso";
    else if(rocks.length>0 && rDone===0) status = "disperso";         // fallaste las prioridades pese a cumplir hábitos
    else if(pct>=80 && pAll && rDone>=2) status = "flujo";
    else if(p23) status = "operativo";
    else status = "disperso";
    // fugas
    const tags = [];
    if(est && !est.logs[key] && !isRest(est,key)) tags.push("Bloque Estudio");
    if(abs && !abs.logs[key] && !isRest(abs,key)) tags.push("Ventana 7:30–9:00 AM");
    if(mov && !mov.logs[key] && !isRest(mov,key)) tags.push("Celular / Pantalla");
    if(!rocks.length) tags.push("Sin Big Rocks");
    if(!tags.length && pAll && (!abs || abs.logs[key] || isRest(abs,key))) tags.push(J_NOLEAK);
    // logros para sugerir en "lo que movió la aguja"
    const wins = rocks.filter(r=>r.done).map(r=>String(r.text).trim()).concat(pillars.filter(h=>h.logs[key]).map(h=>h.name+" ✓"));
    return { status, tags, wins,
      why: `${pct}% hábitos${pillars.length?` · ${pDone}/${pillars.length} pilares`:""} · ${rDone}/${rocks.length} victorias` };
  }

  function journalKey(){ return todayKey(journalDate); }
  const jDay = (key, off) => { const d = new Date(key+"T00:00:00"); d.setDate(d.getDate()+off); return todayKey(d); };
  const jHas = key => !!(state.journal[key] && state.journal[key].status);
  const jDayPct = key => { const p = computeDayProductivity(key); return p.habitsTotal ? Math.round(p.habitsDone/p.habitsTotal*100) : null; };

  /* ---- KPIs ---- */
  function jAmRate(key){
    const am = state.habits.filter(h=>h.timeframe==="am" && !isRest(h,key));
    if(!am.length || isDayDisabled(key)) return null;
    return am.filter(h=>h.logs[key]).length / am.length * 100;
  }
  function renderJournalKpis(){
    const base = new Date(); base.setHours(0,0,0,0);
    // 1) estado operativo promedio 7D
    const sc = [];
    for(let i=0;i<7;i++){ const k = jDay(todayKey(base), -i); if(jHas(k)) sc.push(J_STATUS[state.journal[k].status].score); }
    const avgSc = sc.length ? sc.reduce((a,b)=>a+b,0)/sc.length : null;
    // 2) racha de cierre nocturno
    let streak = 0, k = todayKey(base); if(!jHas(k)) k = jDay(k,-1);
    while(jHas(k)){ streak++; k = jDay(k,-1); }
    // 3) fricción dominante del mes
    const ym = journalKey().slice(0,7), tally = {};
    Object.keys(state.journal).forEach(d=>{ if(d.slice(0,7)!==ym) return; (state.journal[d].leakTags||[]).forEach(t=>{ if(t!==J_NOLEAK) tally[t] = (tally[t]||0)+1; }); });
    state.habits.forEach(h=>{ Object.keys(h.causes||{}).forEach(d=>{ if(d.slice(0,7)===ym && !h.logs[d] && CAUSES[h.causes[d]]){ const l = CAUSES[h.causes[d]].short; tally[l] = (tally[l]||0)+1; } }); });
    const top = Object.keys(tally).sort((a,b)=>tally[b]-tally[a])[0];
    // 4) impacto en el día siguiente (hábitos AM con / sin cierre la noche anterior)
    const withC = [], without = [];
    for(let i=1;i<=90;i++){
      const d = jDay(todayKey(base), -i), r = jAmRate(d); if(r===null) continue;
      (jHas(jDay(d,-1)) ? withC : without).push(r);
    }
    const mean = a => a.reduce((x,y)=>x+y,0)/a.length;
    const enough = withC.length>=3 && without.length>=3;
    const delta = enough ? Math.round(mean(withC)-mean(without)) : null;
    const col = p => progressColor(p);
    document.getElementById("jKpis").innerHTML = `
      <div class="kpi-card" data-tip="Estado operativo promedio\\nEn Flujo=5 · Operativo=4 · Disperso=2.5 · En Fuga=1\\nPromedio de tus cierres de los últimos 7 días">
        <div class="label">Estado operativo (7D)</div>
        <div class="value" style="color:${avgSc===null?"var(--text-faint)":col(avgSc/5*100)}">${avgSc===null?"—":avgSc.toFixed(1)}<small> / 5</small></div>
        <div class="sub">${sc.length?sc.length+" cierre"+(sc.length>1?"s":"")+" esta semana":"Aún sin cierres esta semana"}</div></div>
      <div class="kpi-card" data-tip="Racha de cierre nocturno\\nDías seguidos con tu auditoría guardada">
        <div class="label">Racha de cierre</div>
        <div class="value" style="color:${streak>0?"var(--accent)":"var(--text-faint)"}">${streak>0?"🔥 "+streak:"0"}<small> día${streak===1?"":"s"}</small></div>
        <div class="sub">Auditoría al terminar tu turno</div></div>
      <div class="kpi-card" data-tip="Fricción dominante\\nEl sabotaje más repetido este mes (etiquetas de tus cierres + causas de hábitos fallados)">
        <div class="label">Fricción dominante</div>
        <div class="value" style="font-size:${top&&top.length>16?"15":"18"}px;line-height:1.25;color:${top?"#f59e0b":"var(--text-faint)"}">${top?escHtml(top):"—"}</div>
        <div class="sub">${top?tally[top]+" vez"+(tally[top]>1?"es":"")+" en el mes":"Sin fricciones registradas este mes"}</div></div>
      <div class="kpi-card" data-tip="Impacto en el día siguiente\\nDiferencia de cumplimiento de tus hábitos AM cuando cerraste la bitácora la noche anterior (últimos 90 días)">
        <div class="label">Impacto día siguiente</div>
        <div class="value" style="color:${delta===null?"var(--text-faint)":delta>=0?"#10b981":"#ef4444"}">${delta===null?"—":(delta>=0?"+":"")+delta}<small>${delta===null?"":" pts"}</small></div>
        <div class="sub">${enough?"AM con cierre previo "+Math.round(mean(withC))+"% vs "+Math.round(mean(without))+"% sin cierre":"Necesita ≥3 días con y sin cierre"}</div></div>`;
  }

