  async function cloudInitialSync(){
    setSync("syncing");
    let snap;
    try{ snap = await cloud.ref.get({source:"server"}); }
    catch(e){ syncErr(e); setSync(navigator.onLine ? "error" : "offline"); scheduleRetry(); return; }
    if(!snap.exists){
      cloud.baseRev = 0; cloud.dirty = true; cloudPush(); return;   // cuenta nueva: sube los datos de este dispositivo
    }
    const r = snap.data(), rs = JSON.parse(r.json);
    const neverSynced = cloud.baseRev === -1;
    if(neverSynced && stateHasData(state) && stateHasData(rs)){
      const combine = confirm("Este dispositivo ya tiene datos y tu cuenta también.\n\nAceptar = COMBINAR ambos.\nCancelar = usar SOLO los de tu cuenta (se descartan los de este dispositivo).");
      cloud.baseRev = r.rev;
      if(combine){ applyRemoteState(mergeVal(rs, state)); cloud.dirty=false; cloudTouch(); }
      else { applyRemoteState(rs); cloud.dirty=false; saveMeta(); setSync("ok"); }
      return;
    }
    if(neverSynced && stateHasData(state) && !stateHasData(rs)){
      cloud.baseRev = r.rev; cloud.dirty = true; cloudPush(); return;
    }
    if(r.rev > cloud.baseRev){
      if(cloud.dirty){ cloud.baseRev = r.rev; applyRemoteState(mergeVal(rs, state)); cloud.dirty=false; cloudTouch(); }
      else { cloud.baseRev = r.rev; applyRemoteState(rs); saveMeta(); setSync("ok"); }
