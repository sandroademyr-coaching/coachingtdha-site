  /* ---- Heatmap semanal de capacidad operativa ---- */
  function renderProdTrend(){
    const wrap = document.getElementById("prodBars");
    const today = startOfToday();
    const mon0 = getWeekStart(today);
    const order = [1,2,3,4,5,6,0], letters = ["L","M","X","J","V","S","D"];
    const sums=[0,0,0,0,0,0,0], cnt=[0,0,0,0,0,0,0];
    const rows = [];
    for(let w=7; w>=0; w--){
      const start = new Date(mon0); start.setDate(start.getDate()-7*w);
      const cells = [];
      for(let i=0;i<7;i++){
        const d = new Date(start); d.setDate(d.getDate()+i);
        const key = todayKey(d);
        const future = d>today;
        const sc = future ? {pct:null} : computeDayProductivity(key);
        if(!future && sc.pct!==null && key!==todayKey(today)){ sums[d.getDay()]+=sc.pct; cnt[d.getDay()]++; }
        cells.push({d, key, future, pct:sc.pct});
      }
      rows.push({start, cells});
    }
    const tot = cnt.reduce((a,b)=>a+b,0);
    const overall = tot ? sums.reduce((a,b)=>a+b,0)/tot : null;
    const avgs = sums.map((v,i)=>cnt[i]? Math.round(v/cnt[i]) : null);
    const warnDays = [];
    order.forEach(i=>{ if(avgs[i]!==null && cnt[i]>=2 && overall!==null && avgs[i] <= overall-10) warnDays.push(i); });

    let html = `<div class="cap-grid"><span></span>${order.map((d,i)=>`<div class="cap-h ${warnDays.includes(d)?"warn":""}">${letters[i]}</div>`).join("")}`;
    rows.forEach(r=>{
      html += `<span class="cap-wk">${r.start.toLocaleDateString("es-PE",{day:"numeric",month:"short"})}</span>`;
      order.forEach(wd=>{
        const c = r.cells.find(x=>x.d.getDay()===wd);
        const warn = warnDays.includes(wd) ? " warn" : "";
        const lbl = c.d.toLocaleDateString("es-PE",{weekday:"long",day:"numeric",month:"short"});
        if(c.future) { html += `<div class="cap-cell empty${warn}" style="outline-style:none;"></div>`; return; }
        if(c.pct===null){ html += `<div class="cap-cell${warn}" style="opacity:.4;" data-tip="${lbl}\nsin datos"></div>`; return; }
        html += `<div class="cap-cell${warn}" style="background:${progressColor(c.pct)};opacity:${(.35+.65*c.pct/100).toFixed(2)};" data-tip="${lbl}\nCapacidad: ${c.pct}%">${c.pct}</div>`;
      });
    });
    html += `<span class="cap-wk cap-avg">prom.</span>${order.map(wd=>`<div class="cap-h cap-avg ${warnDays.includes(wd)?"warn":""}">${avgs[wd]===null?"—":avgs[wd]+"%"}</div>`).join("")}</div>`;
    wrap.innerHTML = html;

    const line = document.getElementById("prodInsightLine");
    if(warnDays.length){
      const names = warnDays.map(d=>WEEKDAY_NAMES[d]).join(" y ");
      const worst = warnDays.slice().sort((a,b)=>avgs[a]-avgs[b])[0];
      line.innerHTML = `<span style="color:#f59e0b;">⚠</span> Caída de capacidad los <b style="color:var(--text);">${names}</b>: ${avgs[worst]}% de promedio (${WEEKDAY_NAMES[worst]}) frente a ${Math.round(overall)}% general.`;
    } else {
      line.textContent = overall!==null ? `Capacidad estable entre días · promedio ${Math.round(overall)}%.` : "";
    }
  }

  /* ================= PERÍODOS: SEMANA / MES / TRIMESTRE / AÑO ================= */
  let currentPeriod = "day";
  let periodDates = { week:new Date(), month:new Date(), quarter:new Date(), year:new Date() };

  function pad2(n){ return String(n).padStart(2,"0"); }
  function getWeekStart(d){
    const dt = new Date(d); const day = (dt.getDay()+6)%7;
    dt.setDate(dt.getDate()-day); dt.setHours(0,0,0,0); return dt;
  }
  function getWeekEnd(d){ const s=getWeekStart(d); const e=new Date(s); e.setDate(e.getDate()+6); return e; }
  function getWeekKey(d){
    const t = new Date(d.getFullYear(), d.getMonth(), d.getDate());
    const dayNr = (t.getDay()+6)%7;
    t.setDate(t.getDate()-dayNr+3);
    const firstThursday = new Date(t.getFullYear(),0,4);
    const diff = t - firstThursday;
    const weekNum = 1 + Math.round(diff/(7*86400000));
    return `${t.getFullYear()}-W${pad2(weekNum)}`;
  }
  function getMonthKey(d){ return `${d.getFullYear()}-${pad2(d.getMonth()+1)}`; }
  function getQuarterKey(d){ return `${d.getFullYear()}-Q${Math.floor(d.getMonth()/3)+1}`; }
  function getYearKey(d){ return `${d.getFullYear()}`; }

  function periodKey(period, date){
    if(period==="week") return getWeekKey(date);
    if(period==="month") return getMonthKey(date);
    if(period==="quarter") return getQuarterKey(date);
    if(period==="year") return getYearKey(date);
    return "";
  }
  function periodLabel(period, date){
    if(period==="week"){
      const s=getWeekStart(date), e=getWeekEnd(date);
      const fmt=(x)=>x.toLocaleDateString("es-PE",{day:"numeric",month:"short"});
      return `Semana del ${fmt(s)} al ${fmt(e)}, ${e.getFullYear()}`;
    }
    if(period==="month") return date.toLocaleDateString("es-PE",{month:"long",year:"numeric"});
    if(period==="quarter"){
      const q = Math.floor(date.getMonth()/3)+1;
      const ranges=["Ene–Mar","Abr–Jun","Jul–Sep","Oct–Dic"];
      return `Trimestre ${q} (${ranges[q-1]}), ${date.getFullYear()}`;
    }
    if(period==="year") return `Año ${date.getFullYear()}`;
    return "";
  }
  function periodNav(period, date, dir){
    const d = new Date(date);
    if(period==="week") d.setDate(d.getDate()+7*dir);
    else if(period==="month") d.setMonth(d.getMonth()+dir);
    else if(period==="quarter") d.setMonth(d.getMonth()+3*dir);
    else if(period==="year") d.setFullYear(d.getFullYear()+dir);
    return d;
  }

