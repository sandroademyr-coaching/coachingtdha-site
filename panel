  function hogarImport(file){
    const rd = new FileReader();
    rd.onload = ()=>{
      try{
        const d = JSON.parse(rd.result); if(d.format!=="panel-hogar-v1") throw new Error("no es un paquete Hogar");
        const have = new Set(fin.tx.map(t=>t.id)), mineIds = new Set(fin.tx.filter(t=>t.type==="hogar").map(t=>t.id));
        const add = [];
        (d.tx||[]).forEach(t=>{ if(t && t.id && t.amount>0 && !have.has(t.id) && !(t.id.indexOf("ap-")===0 && mineIds.has(t.id.slice(3)))) add.push(Object.assign({}, t, {space:"hogar", createdAt:t.createdAt||Date.now()})); });
        (d.aportes||[]).forEach(a=>{ if(a && a.id && a.amount>0 && !have.has(a.id) && !mineIds.has(a.id.slice(3)) && !add.some(x=>x.id===a.id)) add.push({id:a.id, date:a.date, amount:a.amount, type:"ingreso", cat:"Fondo", desc:a.desc, payer:a.payer||d.owner, space:"hogar", src:"hogar", createdAt:Date.now()}); });
        if(!add.length){ toast("Nada nuevo en ese paquete"); return; }
        if(!confirm("Importar "+add.length+" movimientos del hogar de "+(d.owner||"otra persona")+"?")) return;
        add.forEach(t=>{ fin.tx.push(t); finPushTx(t); hcPush(t); }); finSaveLocal(); renderFin(); toast("Importados "+add.length+" movimientos del hogar");
      }catch(err){ toast("Paquete no válido: "+err.message); }
    };
    rd.readAsText(file);
  }
  function renderFin(){
    const root = document.getElementById("finBody"); if(!root) return;
    document.getElementById("finMonthLabel").textContent = finMonthLabel(finMonth);
    finSpaceUi();
    try{ hcSyncAportes(); }catch(e){}
    if(finSpace==="hogar"){ renderHogar(); return; }
    const c = fin.cfg;
    const mtx = fin.tx.filter(t=>t.space!=="hogar" && t.date && t.date.slice(0,7)===finMonth);
    const inc = finSum(mtx,"ingreso"), exp = finSum(mtx.filter(finIsSalary),"gasto"), sav = finSum(mtx,"ahorro"), inv = finSum(mtx,"inversion"), hog = finSum(mtx,"hogar");
    const {weeks, N} = finWeeks(finMonth);
    const nowM = todayKey().slice(0,7), isCur = finMonth===nowM, todayD = parseInt(todayKey().slice(8,10));
    const daysEl = isCur ? todayD : (finMonth<nowM ? N : 0);
    const gastoTx = mtx.filter(t=>t.type==="gasto" && finIsSalary(t));
    weeks.forEach(w=>{
      w.spent = gastoTx.filter(t=>{ const d = parseInt(t.date.slice(8,10)); return d>=w.from && d<=w.to; }).reduce((a,t)=>a+t.amount,0);
      w.budget = c.budgetMonth ? c.budgetMonth*w.days/N : 0;
      w.cur = isCur && todayD>=w.from && todayD<=w.to;
    });
    // alertas
    const alerts = [];
    if(c.budgetMonth>0){
      const p = exp/c.budgetMonth*100;
      if(p>=100) alerts.push(["bad", `Superaste tu presupuesto del mes: ${finMoney(exp)} de ${finMoney(c.budgetMonth)} (${Math.round(p)}%).`]);
      else if(p>=c.alertPct) alerts.push(["warn", `Vas en ${Math.round(p)}% del presupuesto mensual (${finMoney(exp)} de ${finMoney(c.budgetMonth)}).`]);
      const cw = weeks.find(w=>w.cur);
      if(cw && cw.budget>0){
        const pw = cw.spent/cw.budget*100;
        if(pw>=100) alerts.push(["bad", `Esta semana ya pasaste tu límite semanal: ${finMoney(cw.spent)} de ${finMoney(cw.budget)}.`]);
        else if(pw>=c.alertPct) alerts.push(["warn", `Esta semana llevas ${Math.round(pw)}% de tu límite semanal.`]);
      }
    }
    const byCat = {}; gastoTx.forEach(t=>{ byCat[t.cat] = (byCat[t.cat]||0) + t.amount; });
    Object.keys(c.catBudgets).forEach(k=>{
