  function computeDayProductivity(dateKey){
    const dayOff = isDayDisabled(dateKey);
    const trackedHabits = dayOff ? [] : state.habits.filter(h=>!isRest(h,dateKey));
    const habitsTotal = trackedHabits.length;
    const habitsDone = trackedHabits.filter(h=>h.logs[dateKey]).length;

    // tareas: victorias del día + (histórico) tareas Eisenhower que ya existían
    const eisen = state.eisenhower[dateKey] || {q1:[],q2:[],q3:[],q4:[]};
    const legacy = [...eisen.q1,...eisen.q2,...eisen.q3,...eisen.q4];
    const rocks = (state.bigRocks[dateKey]||[]).filter(r=>String(r.text||"").trim());
    const eisenTotal = legacy.length + rocks.length;
    const eisenDone = legacy.filter(t=>t.done).length + rocks.filter(r=>r.done).length;

    const totalItems = habitsTotal + eisenTotal, doneItems = habitsDone + eisenDone;
    const pct = totalItems ? Math.round((doneItems/totalItems)*100) : null;
    return {habitsTotal, habitsDone, eisenTotal, eisenDone, pct};
  }

