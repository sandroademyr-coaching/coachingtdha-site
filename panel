    {id:"fis",  tag:"#Físico",   label:"Físico / Biología",   icon:"🫀", w:["dolor","enferm","agotad","pesad","insomni","cansad","migrana","fiebre"], ph:["mal dormid","dormi mal","no dormi","poco sueno"]},
    {id:"ent",  tag:"#Entorno",  label:"Entorno / Desorden",  icon:"🌀", w:["visita","sali","desorden","celular","redes","ruido","tiktok","instagram"], ph:[]}
  ]; }
  function jDetect(text){
    const n = normName(text); if(!n.trim()) return [];
    const toks = n.split(/[^a-z0-9ñ]+/).filter(Boolean);
    return jClusters().filter(c=> c.w.some(st=>toks.some(t=>t.indexOf(st)===0)) || c.ph.some(p=>n.indexOf(p)>=0)).map(c=>c.id);
  }
  function jCluster(id){ return jClusters().find(c=>c.id===id); }
  function jEntryCtx(e){ return e ? jDetect((e.dump||"")+" "+(e.leak||"")) : []; }
  // cruce: hábitos del día del evento y del siguiente vs. tu línea base de 60 días
  function jCross(cid, days){
    days = days||60;
    const today = startOfToday(), tk = todayKey(today);
    const lo = new Date(today); lo.setDate(lo.getDate()-days);
    const loK = todayKey(lo);
    const evDays = Object.keys(state.journal).filter(k=>k>=loK && k<tk && jEntryCtx(state.journal[k]).indexOf(cid)>=0);
    if(evDays.length<2) return {n:evDays.length, rows:[]};
    const obs = new Set();
    evDays.forEach(k=>{ obs.add(k); const nk=jDay(k,1); if(nk<tk) obs.add(nk); });
    const rows = [];
    state.habits.forEach(h=>{
      let ea=0,et=0,ba=0,bt=0;
      for(let d=new Date(lo); d<today; d.setDate(d.getDate()+1)){
        const k=todayKey(d); if(d<getHabitStart(h) || isOffFor(h,k)) continue;
        if(obs.has(k)){ et++; if(h.logs[k]) ea++; } else { bt++; if(h.logs[k]) ba++; }
      }
      if(et<3 || bt<7) return;
      const er=Math.round(ea/et*100), br=Math.round(ba/bt*100);
      rows.push({h, er, br, drop:br-er});
    });
    rows.sort((a,b)=>b.drop-a.drop);
    return {n:evDays.length, rows};
  }
  function jPatternHtml(cid){
    const c = jCluster(cid), r = jCross(cid,60);
    if(r.n<2) return `<div class="jpat soft">${c.icon} <b>${c.label}</b>: aún ${r.n} de 2 registros previos en 60 días para cruzarlo con tus hábitos.</div>`;
    const top = r.rows.filter(x=>x.drop>=15).slice(0,2);
    if(!top.length) return `<div class="jpat soft">${c.icon} <b>${c.label}</b>: ${r.n} registros en 60 días y tus hábitos no muestran una caída clara (≥15 pts) en ese día ni al siguiente.</div>`;
    const txt = top.map(x=>`<b>${escHtml(shortName(x.h))}</b> ${x.er===0?"baja a 0%":"cae "+x.drop+" pts"}${x.er===0?"":" ("+x.br+"% → "+x.er+"%)"}`).join(" y ");
    return `<div class="jpat">🔎 <b>Patrón detectado:</b> en los últimos 60 días, cuando registras <b>${c.label}</b> (${r.n} veces), ${txt} ese día y el siguiente.</div>`;
  }
