  let trendOffset = 0; // meses hacia atrás desde hoy (se mueve de a 6)
  function lastMonths(n, offset){
    offset = offset || 0;
    const arr = [];
    const now = new Date();
    for(let i=n-1;i>=0;i--){
      arr.push(new Date(now.getFullYear(), now.getMonth()-i-offset, 1));
    }
    return arr;
  }
  function earliestTrackedMonth(){
    if(!state.habits.length) return null;
    const t = Math.min(...state.habits.map(h=>getHabitStart(h).getTime()));
    const d = new Date(t);
    return new Date(d.getFullYear(), d.getMonth(), 1);
  }

  function computeMonthlyRate(habit, monthDate){
    const year = monthDate.getFullYear(), month = monthDate.getMonth();
    const monthStart = new Date(year, month, 1);
    const monthEnd = new Date(year, month+1, 0);
    const now = new Date();
    const effectiveEnd = monthEnd > now ? now : monthEnd;
    if(effectiveEnd < monthStart) return null;

    if(habit){
      const start = getHabitStart(habit);
      const rangeStart = start > monthStart ? start : monthStart;
      if(rangeStart > effectiveEnd) return null;
      let total=0, done=0;
      for(let d=new Date(rangeStart); d<=effectiveEnd; d.setDate(d.getDate()+1)){
        const key = todayKey(d);
        if(isOffFor(habit,key)) continue;
        total++;
        if(habit.logs[key]) done++;
      }
      if(total===0) return null;
      return Math.round((done/total)*100);
    } else {
      if(state.habits.length===0) return null;
      const rates = state.habits.map(h=>computeMonthlyRate(h, monthDate)).filter(r=>r!==null);
      if(rates.length===0) return null;
      return Math.round(rates.reduce((a,b)=>a+b,0)/rates.length);
    }
  }

