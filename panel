    ov.innerHTML = `<div class="modal" style="max-height:90vh;overflow-y:auto;"><h3>${title}</h3>${body}<div style="display:flex;gap:8px;justify-content:flex-end;margin-top:14px;"><button class="btn ghost" data-x>Cancelar</button><button class="btn" data-ok>Guardar</button></div></div>`;
    document.body.appendChild(ov);
