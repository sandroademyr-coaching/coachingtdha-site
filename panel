  function isObjV(x){ return x && typeof x==="object" && !Array.isArray(x); }
  // Combina nube y local: une claves; en conflicto de valores simples gana lo local; listas con id se unen por id
  function mergeVal(r, l){
    if(isObjV(r) && isObjV(l)){
      const o = Object.assign({}, r);
      Object.keys(l).forEach(k=>{ o[k] = (k in r) ? mergeVal(r[k], l[k]) : l[k]; });
