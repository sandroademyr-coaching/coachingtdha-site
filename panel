    document.getElementById("objListTitle").textContent = PERIOD_TITLES[period] || "Objetivos";

    renderObjKPIs();
    renderPeriodEisenBoard();

    const list = getObjList(period, key);
    const wrap = document.getElementById("objectivesList");
    if(list.length===0){
      wrap.innerHTML = `<div class="empty-state"><div class="big">🎯</div><p>No tienes objetivos registrados para este período.</p>
        <button class="btn" onclick="document.getElementById('addObjectiveBtn').click()">+ Nuevo objetivo</button></div>`;
      return;
    }
    wrap.innerHTML = "";
    list.slice().sort((a,b)=> (b.createdAt||"").localeCompare(a.createdAt||"")).forEach(o=>{
      const sMeta = STATUS_META[o.status] || STATUS_META.no_iniciado;
