  /* ---------------- Comparativa y tendencia ---------------- */
  const WEEKDAY_NAMES = ["domingo","lunes","martes","miércoles","jueves","viernes","sábado"];

  function computeHardestWeekdayProductivity(){
    const sums=[0,0,0,0,0,0,0], counts=[0,0,0,0,0,0,0];
    for(let i=0;i<56;i++){
      const d = dateFromOffset(-i);
      const key = todayKey(d);
      const s = computeDayProductivity(key);
      if(s.pct===null) continue;
      const wd = d.getDay();
      sums[wd]+=s.pct; counts[wd]++;
    }
    let worstIdx=-1, worstRate=Infinity;
    for(let i=0;i<7;i++){
      if(counts[i]<2) continue;
      const avg = sums[i]/counts[i];
      if(avg<worstRate){ worstRate=avg; worstIdx=i; }
    }
    if(worstIdx===-1) return null;
    return { weekday: WEEKDAY_NAMES[worstIdx], rate: Math.round(worstRate) };
  }

