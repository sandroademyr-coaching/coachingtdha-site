    const c = {elite:0, mant:0, fuga:0};
    for(let d=new Date(first); d<=last; d.setDate(d.getDate()+1)){
      const k = todayKey(d);
      if(isDayDisabled(k)) continue;
      const act = state.habits.filter(h=>getHabitStart(h)<=d && !isRest(h,k));
      if(!act.length) continue;
      const pct = act.filter(h=>h.logs[k]).length/act.length*100;
      if(pct>=80) c.elite++; else if(pct>=50) c.mant++; else c.fuga++;
    }
    const tot = c.elite+c.mant+c.fuga;
    const cats = [
      {k:"elite", n:"Días élite", r:"80–100%", col:COL.ok},
