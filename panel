  function renderObjKPIs(){
    const period = currentPeriod;
    const key = periodKey(period, periodDates[period]);
    const list = getObjList(period, key);
    const eisen = getPeriodEisen(period, key);
    const eisenTasks = [...eisen.q1, ...eisen.q2, ...eisen.q3, ...eisen.q4];
    const total = list.length;
    const done = list.filter(o=>o.status==="completado").length;
    const avgProgress = total ? Math.round(list.reduce((s,o)=>s+o.progress,0)/total) : 0;
    const eisenTotal = eisenTasks.length, eisenDone = eisenTasks.filter(t=>t.done).length;
    const eisenPct = eisenTotal ? Math.round((eisenDone/eisenTotal)*100) : null;
    document.getElementById("objKpiGrid").innerHTML = `
