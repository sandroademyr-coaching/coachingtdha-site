    const ics = [
      "BEGIN:VCALENDAR","VERSION:2.0","PRODID:-//Panel Sandro//ES","BEGIN:VEVENT",
      `UID:${r.id}@panel-sandro`,
      `DTSTAMP:${toICSDate(new Date())}`,
      `DTSTART:${toICSDate(start)}`,
      `DTEND:${toICSDate(end)}`,
      `SUMMARY:${r.message.replace(/\n/g," ")}`,
      "BEGIN:VALARM", `TRIGGER:${icsTrigger(r.offsetMinutes)}`, "ACTION:DISPLAY",
      `DESCRIPTION:${r.message.replace(/\n/g," ")}`, "END:VALARM",
      "END:VEVENT","END:VCALENDAR"
    ].join("\r\n");
    const blob = new Blob([ics], {type:"text/calendar"});
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url; a.download = `recordatorio-${r.id}.ics`; a.click();
