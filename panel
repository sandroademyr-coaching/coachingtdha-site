    const months = lastMonths(6, trendOffset);
    const earliest = earliestTrackedMonth();
    const prevBtn = document.getElementById("trendPrev"), nextBtn = document.getElementById("trendNext");
    const canPrev = earliest && months[0] > earliest;
    prevBtn.disabled = !canPrev; prevBtn.style.opacity = canPrev ? "1" : ".3"; prevBtn.style.cursor = canPrev ? "pointer" : "default";
    nextBtn.disabled = trendOffset===0; nextBtn.style.opacity = trendOffset===0 ? ".3" : "1"; nextBtn.style.cursor = trendOffset===0 ? "default" : "pointer";
    const f = months[0], l = months[months.length-1];
    document.getElementById("trendRangeLabel").textContent = f.getFullYear()===l.getFullYear()
      ? `${shortMonth(f)} – ${shortMonth(l)} ${l.getFullYear()}`
      : `${shortMonth(f)} ${f.getFullYear()} – ${shortMonth(l)} ${l.getFullYear()}`;
    const points = months.map(d=>({
      date: d,
      label: d.toLocaleDateString("es-PE",{month:"short"}).replace(".",""),
      year: d.getFullYear(),
      rate: computeMonthlyRate(habit, d)
    }));
    monthlyTrendPoints = points;

    // --- gráfico lineal SVG: curva suave + área con degradado ---
    const w=600, h=210, padL=34, padR=14, padT=16, padB=28;
    const plotW = w-padL-padR, plotH = h-padT-padB;
    const n = points.length;
    const xAt = (i)=> padL + (n<=1 ? plotW/2 : (i/(n-1))*plotW);
    const yAt = (rate)=> padT + plotH - (rate/100)*plotH;
    const gradId = "trendGrad";

    let gridSvg = "";
    [0,25,50,75,100].forEach(g=>{
      const y = yAt(g);
      gridSvg += `<line x1="${padL}" y1="${y}" x2="${w-padR}" y2="${y}" stroke="var(--border)" stroke-width="1" stroke-dasharray="3,4"/>`;
      gridSvg += `<text x="${padL-8}" y="${y+3}" text-anchor="end" font-size="9" fill="var(--text-faint)">${g}</text>`;
    });

    let segments = [], current = [];
    points.forEach((p,i)=>{
      if(p.rate===null){
        if(current.length>1) segments.push(current);
        current = [];
      } else {
        current.push({x:xAt(i), y:yAt(p.rate)});
      }
    });
    if(current.length>1) segments.push(current);

    const areaSvg = segments.map(seg=>{
      const path = smoothPath(seg);
      const base = h-padB;
      return `<path d="${path} L ${seg[seg.length-1].x},${base} L ${seg[0].x},${base} Z" fill="url(#${gradId})" stroke="none"/>`;
    }).join("");

    const lineSvg = segments.map(seg=>
      `<path class="trend-line-path" d="${smoothPath(seg)}" fill="none" stroke="var(--accent)" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round"/>`
    ).join("");

    const dotsSvg = points.map((p,i)=>{
      if(p.rate===null) return "";
      const x=xAt(i), y=yAt(p.rate);
      return `<circle class="trend-dot" cx="${x}" cy="${y}" r="9" fill="transparent" data-tip="${p.label} ${p.year}: ${p.rate}%"></circle>`;
    }).join("");

    const labelsSvg = points.map((p,i)=>
      `<text x="${xAt(i)}" y="${h-8}" text-anchor="middle" font-size="10" fill="var(--text-faint)">${p.label}</text>`
    ).join("");

    document.getElementById("trendChart").innerHTML = `
      <svg viewBox="0 0 ${w} ${h}" width="100%" height="210" preserveAspectRatio="none">
        <defs>
          <linearGradient id="${gradId}" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.32"/>
            <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"/>
          </linearGradient>
        </defs>
        ${gridSvg}${areaSvg}${lineSvg}${dotsSvg}${labelsSvg}
      </svg>`;

    // animación de dibujo de la línea
    requestAnimationFrame(()=>{
      document.querySelectorAll("#trendChart .trend-line-path").forEach(path=>{
        const len = path.getTotalLength();
        path.style.strokeDasharray = len;
        path.style.strokeDashoffset = len;
        path.getBoundingClientRect(); // forzar reflow
        path.style.strokeDashoffset = 0;
      });
    });

    // --- donas por mes ---
    const openMonthKey = document.getElementById("monthDetailPanel").dataset.monthKey;
    document.getElementById("trendMonthList").innerHTML = points.map((p,i)=>{
      const key = `${p.date.getFullYear()}-${String(p.date.getMonth()+1).padStart(2,"0")}`;
      const isActive = key===openMonthKey;
      if(p.rate===null){
        return `<div class="tmd-item tmd-empty" data-month-idx="${i}">
          ${donutSVG(0, "var(--surface-3)", {size:52, strokeWidth:5, wrapClass:"tmd-donut", valueClass:"tmd-donut-value"})}
          <div class="tmd-label">${p.label}</div>
        </div>`;
      }
      return `<div class="tmd-item ${isActive?"active":""}" data-month-idx="${i}" data-tip="${p.label} ${p.year}: ${p.rate}%\nClic para ver por hábito">
        ${donutSVG(p.rate, progressColor(p.rate), {size:52, strokeWidth:5, wrapClass:"tmd-donut", valueClass:"tmd-donut-value"})}
        <div class="tmd-label">${p.label}</div>
      </div>`;
    }).join("");

    document.querySelectorAll("#trendMonthList .tmd-item").forEach(el=>{
      el.addEventListener("click", ()=>{
        const idx = parseInt(el.dataset.monthIdx);
        showMonthDetail(points[idx]);
      });
    });

    if(openMonthKey){
      const match = points.find(p=>`${p.date.getFullYear()}-${String(p.date.getMonth()+1).padStart(2,"0")}`===openMonthKey);
      if(match) showMonthDetail(match, true); else closeMonthDetail();
    }
  }

