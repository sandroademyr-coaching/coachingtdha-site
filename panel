  // ---- Importar tabla (CSV/TSV/pegado) ----
  function parseDateCell(v){
    v = String(v||"").trim();
    let m = v.match(/^(\d{4})[-\/.](\d{1,2})[-\/.](\d{1,2})$/);
    if(m) return `${m[1]}-${pad2(m[2])}-${pad2(m[3])}`;
    m = v.match(/^(\d{1,2})[-\/.](\d{1,2})[-\/.](\d{4})$/);   // día/mes/año (formato Perú)
    if(m) return `${m[3]}-${pad2(m[2])}-${pad2(m[1])}`;
    return null;
  }
  function cellValue(v){
    const t = String(v||"").trim().toLowerCase();
    if(t==="") return null;
    if(["1","x","✓","✔","☑","si","sí","true","verdadero","v","ok","hecho","100%","y","yes"].includes(t)) return true;
    if(["0","no","false","falso","✗","✘","☐","n","0%"].includes(t)) return false;
    const num = parseFloat(t.replace("%",""));
    if(!isNaN(num)) return num>0;
    return null;
  }
  function splitLine(line, delim){
    const out=[]; let cur="", q=false;
    for(let i=0;i<line.length;i++){
      const c=line[i];
      if(c==='"'){ if(q && line[i+1]==='"'){ cur+='"'; i++; } else q=!q; }
      else if(c===delim && !q){ out.push(cur); cur=""; }
      else cur+=c;
    }
    out.push(cur); return out;
  }
  function parseTable(text){
    const lines = text.replace(/\r/g,"").split("\n").filter(l=>l.trim()!=="");
    if(!lines.length) return null;
    const first = lines[0];
    const delim = [["\t",(first.match(/\t/g)||[]).length],[";",(first.match(/;/g)||[]).length],[",",(first.match(/,/g)||[]).length]].sort((a,b)=>b[1]-a[1])[0][0];
    const rows = lines.map(l=>splitLine(l,delim));
    // Disposición A: fechas en la primera fila
    const headDates = rows[0].slice(1).map(parseDateCell);
    const res = {}; // nombre -> {fecha:bool}
    let layout = null;
    if(headDates.filter(Boolean).length >= 3){
      layout="hábitos en filas";
      rows.slice(1).forEach(r=>{
        const name = (r[0]||"").trim(); if(!name) return;
        r.slice(1).forEach((c,i)=>{ const d=headDates[i]; if(!d) return; const v=cellValue(c); if(v===null) return; (res[name]=res[name]||{})[d]=v; });
      });
    } else {
      // Disposición B: fechas en la primera columna
      const colDates = rows.slice(1).map(r=>parseDateCell(r[0]));
      if(colDates.filter(Boolean).length >= 3){
        layout="fechas en filas";
        const names = rows[0].slice(1).map(x=>(x||"").trim());
        rows.slice(1).forEach((r,ri)=>{
          const d = colDates[ri]; if(!d) return;
          names.forEach((nm,i)=>{ if(!nm) return; const v=cellValue(r[i+1]); if(v===null) return; (res[nm]=res[nm]||{})[d]=v; });
        });
      }
    }
    return layout ? {layout, data:res} : null;
  }
  let csvParsed = null;
  function previewCsv(text){
    const out = document.getElementById("csvPreview"), btn = document.getElementById("csvApplyBtn");
    csvParsed = null; btn.style.display = "none";
    if(!text.trim()){ out.textContent=""; return; }
    const t = parseTable(text);
    if(!t || !Object.keys(t.data).length){ out.textContent = "No pude reconocer la tabla. Necesito una fila (o columna) con al menos 3 fechas y una columna (o fila) con los nombres de hábitos."; return; }
    csvParsed = t;
    const names = Object.keys(t.data);
    const lines = names.map(n=>{
      const ent = Object.entries(t.data[n]); const ds = ent.map(e=>e[0]).sort();
      const ex = state.habits.find(h=>normName(h.name)===normName(n));
      return `• ${n}${ex?"":" (nuevo)"}: ${ent.filter(e=>e[1]).length} cumplidos de ${ent.length} días · ${ds[0]} → ${ds[ds.length-1]}`;
    });
    out.innerHTML = `<b>Reconocido (${t.layout}):</b> ${names.length} hábitos<br>` + lines.map(escHtml).join("<br>");
    btn.style.display = "inline-block";
  }
  document.getElementById("csvPaste").addEventListener("input", e=>previewCsv(e.target.value));
